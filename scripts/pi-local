#!/usr/bin/env python3
"""Thin Pi role runner that delegates lifecycle ownership to scripts/pi-model."""

from __future__ import annotations

import importlib.util
import json
import os
import subprocess
import sys
from collections.abc import Sequence
from importlib.machinery import SourceFileLoader
from pathlib import Path
from types import ModuleType

ROOT = Path(__file__).resolve().parent.parent
PI_ENTRYPOINT = Path.home() / ".local" / "bin" / "pi"
ROLE_ALIASES = {"general": "GENERAL", "code": "CODE", "patch": "GPTOSS", "gptoss": "GPTOSS"}
GUARD_EXTENSION = Path(".pi/extensions/neuralengine-guard.ts")


class LocalPiError(RuntimeError):
    """A fail-closed operator error."""


def _load_adapter() -> ModuleType:
    path = ROOT / "scripts" / "pi-model"
    loader = SourceFileLoader("neuralengine_pi_model", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise LocalPiError("cannot load scripts/pi-model")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def _reject_role_overrides(arguments: Sequence[str], *, guard_required: bool = False) -> None:
    for argument in arguments:
        if argument == "--":
            break
        if argument == "--provider" or argument.startswith("--provider="):
            raise LocalPiError("provider is selected by the role; do not override --provider")
        if argument == "--model" or argument.startswith("--model="):
            raise LocalPiError("model is selected by the role; do not override --model")
        if guard_required and (
            argument in {"--extension", "-e", "--no-extensions", "-ne"}
            or argument.startswith("--extension=")
        ):
            raise LocalPiError(
                "bounded CODE/PATCH requires the project Guard; do not override extension loading"
            )


def _guard_extension_path() -> Path:
    path = ROOT / GUARD_EXTENSION
    try:
        resolved = path.resolve(strict=True)
        resolved.relative_to(ROOT.resolve(strict=True))
    except (OSError, ValueError) as error:
        raise LocalPiError(f"required Guard extension is unavailable: {path}") from error
    if not resolved.is_file():
        raise LocalPiError(f"required Guard extension is not a file: {path}")
    return resolved


def _policy_path(role: str, requested: str | None) -> Path:
    value = requested or os.environ.get("NEURAL_PI_POLICY_FILE")
    if not value:
        raise LocalPiError(f"{role} requires --policy PATH for bounded Governor execution")
    path = Path(value)
    if not path.is_absolute():
        path = ROOT / path
    try:
        path = path.resolve(strict=True)
        path.relative_to(ROOT)
    except (OSError, ValueError) as error:
        raise LocalPiError(f"policy must be an existing file inside {ROOT}") from error
    try:
        policy = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise LocalPiError(f"cannot read policy {path}: {error}") from error
    expected_role = "PATCH" if role == "GPTOSS" else role
    if not isinstance(policy, dict) or policy.get("ROLE") != expected_role:
        raise LocalPiError(f"policy ROLE must be {expected_role}")
    if policy.get("WORKSPACE_ROOT") != str(ROOT):
        raise LocalPiError(f"policy WORKSPACE_ROOT must be {ROOT}")
    return path


def _environment(role: str, policy: Path | None) -> dict[str, str]:
    environment = os.environ.copy()
    environment["NEURALENGINE_PI_PROJECT_ROOT"] = str(ROOT)
    environment.pop("NEURAL_PI_BOUNDED_CODE", None)
    environment.pop("NEURAL_PI_POLICY_FILE", None)
    if policy is not None:
        environment["NEURAL_PI_BOUNDED_CODE"] = "1"
        environment["NEURAL_PI_POLICY_FILE"] = str(policy.relative_to(ROOT))
    return environment


def _run_role(role: str, pi_arguments: Sequence[str], requested_policy: str | None) -> int:
    adapter = _load_adapter()
    guard_required = role in {"CODE", "GPTOSS"}
    _reject_role_overrides(pi_arguments, guard_required=guard_required)
    policy = _policy_path(role, requested_policy) if guard_required else None
    guard_extension = _guard_extension_path() if guard_required else None
    if role == "GENERAL" and requested_policy is not None:
        raise LocalPiError("GENERAL does not use a bounded mutation policy")
    executable = PI_ENTRYPOINT.resolve(strict=True)
    if not executable.is_file() or not os.access(executable, os.X_OK):
        raise LocalPiError(f"upstream Pi executable is unavailable: {PI_ENTRYPOINT}")

    current = adapter.identify(adapter.scan())
    owns_runtime = current is None or current.profile != role
    command = [
        str(executable),
        "--provider",
        adapter.PROVIDERS[role],
        "--model",
        adapter.MODELS[role],
        *([] if guard_extension is None else ["--extension", str(guard_extension)]),
        *pi_arguments,
    ]
    completed: subprocess.CompletedProcess[str] | None = None
    cleanup_error: Exception | None = None
    switched = False
    try:
        selected = adapter.switch(role)
        if selected.profile != role:
            raise LocalPiError(f"selected profile {selected.profile} does not match {role}")
        switched = True
        completed = subprocess.run(command, cwd=ROOT, env=_environment(role, policy), check=False)
    except (OSError, adapter.SwitchError) as error:
        raise LocalPiError(str(error)) from error
    finally:
        if owns_runtime and switched:
            try:
                adapter.stop_current()
            except (OSError, adapter.SwitchError) as error:
                cleanup_error = error
    if cleanup_error is not None:
        raise LocalPiError(f"Pi task finished but guarded cleanup failed: {cleanup_error}")
    assert completed is not None
    return completed.returncode


def main(arguments: Sequence[str] | None = None) -> int:
    values = list(sys.argv[1:] if arguments is None else arguments)
    if not values or values[0] in {"-h", "--help"}:
        print(
            "usage: scripts/pi-local {general|code|patch|status} [--policy PATH] [-- PI_ARGS ...]"
        )
        return 0 if values else 2
    command = values.pop(0).lower()
    if command == "status":
        if values:
            print("pi-local: status does not accept task arguments", file=sys.stderr)
            return 2
        try:
            return _load_adapter().status()
        except (OSError, LocalPiError) as error:
            print(f"pi-local: {error}", file=sys.stderr)
            return 1
    if command == "vision":
        print("pi-local: VISION is UNFILLED/unsupported: no model is assigned", file=sys.stderr)
        return 1
    role = ROLE_ALIASES.get(command)
    if role is None:
        print(f"pi-local: unsupported role {command}", file=sys.stderr)
        return 2

    requested_policy: str | None = None
    pi_arguments: list[str] = []
    index = 0
    while index < len(values):
        value = values[index]
        if value == "--policy":
            if index + 1 >= len(values):
                print("pi-local: --policy requires a path", file=sys.stderr)
                return 2
            requested_policy = values[index + 1]
            index += 2
            continue
        if value.startswith("--policy="):
            requested_policy = value.partition("=")[2]
            index += 1
            continue
        if value == "--":
            pi_arguments.extend(values[index:])
            break
        pi_arguments.append(value)
        index += 1
    try:
        return _run_role(role, pi_arguments, requested_policy)
    except (OSError, LocalPiError) as error:
        print(f"pi-local: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
