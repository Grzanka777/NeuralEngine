#!/usr/bin/env python3
"""Static, read-only regression gate for the manifest-driven local LLM stack."""

from __future__ import annotations

import argparse
import json
import sys
import time
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
from typing import Any

REPO = Path(__file__).resolve().parent.parent
CHECKS = (
    ("MANIFEST", "REPO_BOUND"),
    ("ROLE_SCHEMA", "REPO_BOUND"),
    ("ENDPOINT_PROJECTION", "REPO_BOUND"),
    ("CLIENT_PROJECTION", "REPO_BOUND"),
    ("LIFECYCLE_OWNERSHIP", "REPO_BOUND"),
    ("OPENCODE_PARKED", "REPO_BOUND"),
    ("MODEL_INVENTORY", "HOST_BOUND"),
)


def _load_json(path: Path) -> dict[str, Any]:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise ValueError(f"expected a JSON object: {path}")
    return value


def _load_module(path: Path, name: str) -> Any:
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"cannot load {path}")
    module = module_from_spec(spec)
    sys.modules[spec.name] = module
    loader.exec_module(module)
    return module


def _finding(report: dict[str, Any], check: str, code: str, message: str, source: str) -> None:
    report["checks"][check]["status"] = "FAIL"
    report["findings"].append(
        {
            "check": check,
            "code": code,
            "type": report["checks"][check]["type"],
            "message": message,
            "source": source,
        }
    )


def _read_routes(root: Path, manifest: dict[str, Any]) -> tuple[Any, list[dict[str, Any]]]:
    projection = _load_module(
        root / "scripts/sync-llm-client-projections", "_llm_client_projection"
    )
    routes = projection.local_routes(manifest)
    return projection, routes


def _check_repo_client_projection(
    report: dict[str, Any], root: Path, manifest: dict[str, Any]
) -> None:
    try:
        projection, routes = _read_routes(root, manifest)
    except (KeyError, TypeError, ValueError) as error:
        _finding(
            report, "CLIENT_PROJECTION", "INVALID_CLIENT_MANIFEST", str(error), "llm-manifest.json"
        )
        return
    qwen_path = root / ".qwen/settings.json"
    qwen = _load_json(qwen_path)
    expected_qwen = projection.qwen_projection(qwen, routes)
    if qwen.get("modelProviders", {}).get("openai") != expected_qwen["modelProviders"]["openai"]:
        _finding(
            report,
            "CLIENT_PROJECTION",
            "QWEN_ROUTE_DRIFT",
            "Qwen local routes differ from manifest projection.",
            ".qwen/settings.json",
        )
    if qwen.get("model") != expected_qwen.get("model"):
        _finding(
            report,
            "CLIENT_PROJECTION",
            "QWEN_DEFAULT_DRIFT",
            "Qwen default route differs from manifest projection.",
            ".qwen/settings.json",
        )

    pi_path = root / ".pi/settings.json"
    pi = _load_json(pi_path)
    expected_pi = projection.pi_projection(pi, manifest)
    if pi.get("enabledModels") != expected_pi.get("enabledModels"):
        _finding(
            report,
            "CLIENT_PROJECTION",
            "PI_ROUTE_DRIFT",
            "Pi local route allowlist differs from manifest projection.",
            ".pi/settings.json",
        )
    contract = manifest["clients"]["pi"]
    if (pi.get("defaultProvider"), pi.get("defaultModel")) != (
        contract["cloud_default_provider"],
        contract["cloud_default_model"],
    ):
        _finding(
            report,
            "CLIENT_PROJECTION",
            "PI_CLOUD_DEFAULT_DRIFT",
            "Pi cloud default is not preserved.",
            ".pi/settings.json",
        )


def _check_opencode(report: dict[str, Any], root: Path, *, include_host: bool) -> None:
    paths = [root / "opencode.json"]
    if include_host:
        paths.append(Path.home() / ".config/opencode/opencode.json")
    for path in paths:
        if not path.is_file():
            continue
        config = _load_json(path)
        providers = config.get("provider", {})
        selected = [config.get("model")]
        selected.extend(
            agent.get("model")
            for agent in config.get("agents", {}).values()
            if isinstance(agent, dict)
        )
        if any(name.startswith("llama-") for name in providers):
            _finding(
                report,
                "OPENCODE_PARKED",
                "LOCAL_PROVIDER_ACTIVE",
                "OpenCode still declares a local provider.",
                str(path),
            )
        if any(isinstance(value, str) and value.startswith("llama-") for value in selected):
            _finding(
                report,
                "OPENCODE_PARKED",
                "LOCAL_MODEL_ACTIVE",
                "OpenCode still selects a local model.",
                str(path),
            )


def evaluate(repo_root: Path = REPO, *, repo_only: bool = False) -> tuple[dict[str, Any], int]:
    started = time.perf_counter_ns()
    root = repo_root.resolve()
    report = {
        "status": "PASS",
        "mode": "fast",
        "scope": ["REPO_BOUND"] if repo_only else ["REPO_BOUND", "HOST_BOUND"],
        "duration_ms": 0,
        "checks": {name: {"type": kind, "status": "NOT_RUN"} for name, kind in CHECKS},
        "findings": [],
    }
    exit_code = 0
    try:
        manifest = _load_json(root / "llm-manifest.json")
        if type(manifest.get("schema_version")) is not int or manifest["schema_version"] != 2:
            raise ValueError("unsupported manifest schema_version")
        report["checks"]["MANIFEST"]["status"] = "PASS"
        validator = _load_module(root / "scripts/validate-llm-manifest", "_llm_manifest_validator")
        errors = validator.validate(
            root / "llm-manifest.json",
            check_host=not repo_only,
            check_host_assets=False,
            repo_root=root,
        )
        for message in errors:
            lowered = message.lower()
            check = "ENDPOINT_PROJECTION" if "endpoint" in lowered else "ROLE_SCHEMA"
            if any(term in lowered for term in ("qwen", "pi", "client", "opencode")):
                check = "CLIENT_PROJECTION"
            if "lifecycle" in lowered:
                check = "LIFECYCLE_OWNERSHIP"
            _finding(report, check, "CONTRACT_DRIFT", message, "llm-manifest.json")
        for check_name, _ in CHECKS:
            if report["checks"][check_name]["status"] == "NOT_RUN":
                report["checks"][check_name]["status"] = "PASS"

        manifest_roles = manifest.get("roles", {})
        if set(manifest_roles) != {"LOCAL_GENERAL", "LOCAL_CODE", "LOCAL_VISION"}:
            _finding(
                report,
                "ROLE_SCHEMA",
                "ROLE_SET_DRIFT",
                "Unexpected canonical local role set.",
                "llm-manifest.json",
            )
        if "PATCH" in manifest_roles:
            _finding(
                report,
                "ROLE_SCHEMA",
                "PATCH_ROLE_PRESENT",
                "PATCH is not a canonical local model role.",
                "llm-manifest.json",
            )
        challenger = manifest.get("challengers", {}).get("qwen38", {})
        if (
            challenger.get("status") != "QUALIFIED"
            or challenger.get("eligible_for_role_assignment") is not True
            or challenger.get("qualified_roles") != ["LOCAL_CODE"]
        ):
            _finding(
                report,
                "ROLE_SCHEMA",
                "QWEN38_SCOPE_DRIFT",
                "Qwen3.8 qualification must be scoped to LOCAL_CODE.",
                "llm-manifest.json",
            )
        if (
            challenger.get("qualification", {}).get("R2.3") != "NOT_RUN"
            or challenger.get("qualification", {}).get("benchmarks_frozen") is not True
        ):
            _finding(
                report,
                "ROLE_SCHEMA",
                "BENCHMARK_STATE_DRIFT",
                "R2.3 must remain unrun and benchmarks frozen.",
                "llm-manifest.json",
            )

        _check_repo_client_projection(report, root, manifest)

        qwen_wrapper = (root / "scripts/qwen-role.fish").read_text(encoding="utf-8")
        pi_extension = (root / "integrations/pi/extensions/local-model-projection.ts").read_text(
            encoding="utf-8"
        )
        opencode_wrapper = (root / "scripts/opencode-watch").read_text(encoding="utf-8")
        lifecycle_errors = []
        if any(token in qwen_wrapper for token in ("llm start", "llm stop", "--expected-profile")):
            lifecycle_errors.append("Qwen wrapper requests runtime lifecycle ownership")
        if any(
            token in pi_extension for token in ("child_process", "llm start", "llm stop", "spawn(")
        ):
            lifecycle_errors.append("Pi extension contains local lifecycle operations")
        if "llm start" in opencode_wrapper or "llm stop" in opencode_wrapper:
            lifecycle_errors.append(
                "OpenCode compatibility wrapper contains local lifecycle operations"
            )
        if lifecycle_errors:
            for message in lifecycle_errors:
                _finding(
                    report,
                    "LIFECYCLE_OWNERSHIP",
                    "CLIENT_LIFECYCLE_ACTIVE",
                    message,
                    "client adapters",
                )

        _check_opencode(report, root, include_host=not repo_only)

        if repo_only:
            report["checks"]["MODEL_INVENTORY"]["status"] = "NOT_RUN"
        else:
            report["checks"]["MODEL_INVENTORY"]["status"] = "PASS"
            for model_name, model in manifest.get("models", {}).items():
                path_value = model.get("artifact_path")
                if not isinstance(path_value, str) or not Path(path_value).is_file():
                    _finding(
                        report,
                        "MODEL_INVENTORY",
                        "ASSET_MISSING",
                        f"A model inventory asset is unavailable: {model_name}",
                        "llm-manifest.json",
                    )

    except (OSError, KeyError, IndexError, TypeError, ValueError, RuntimeError) as error:
        report["status"] = "ERROR"
        exit_code = 2
        _finding(report, "MANIFEST", "INVALID_INPUT", str(error), "repository")

    if exit_code == 0 and report["findings"]:
        report["status"] = "FAIL"
        exit_code = 1
    report["findings"].sort(
        key=lambda item: (item["check"], item["code"], item["source"], item["message"])
    )
    report["duration_ms"] = max(0, (time.perf_counter_ns() - started) // 1_000_000)
    return report, exit_code


def _human_output(report: dict[str, Any]) -> str:
    scope = "REPO" if report["scope"] == ["REPO_BOUND"] else "REPO+HOST"
    lines = [f"FAST_GATE={report['status']}", f"GATE_SCOPE={scope}"]
    lines.extend(f"{name}={report['checks'][name]['status']}" for name, _ in CHECKS)
    lines.append(f"DURATION_MS={report['duration_ms']}")
    lines.extend(
        f"FINDING={item['code']} | {item['source']} | {item['message']}"
        for item in report["findings"]
    )
    return "\n".join(lines)


def main(argv: list[str] | None = None, *, repo_root: Path = REPO) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=("fast",))
    parser.add_argument("--repo-only", action="store_true", help="run repository-bound checks only")
    parser.add_argument("--json", action="store_true", help="emit the structured report")
    try:
        args = parser.parse_args(argv)
    except SystemExit as error:
        return int(error.code)
    report, exit_code = evaluate(repo_root, repo_only=args.repo_only)
    print(json.dumps(report, indent=2, sort_keys=True) if args.json else _human_output(report))
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
