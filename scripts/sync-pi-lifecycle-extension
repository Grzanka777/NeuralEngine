#!/usr/bin/env python3
"""Compatibility wrapper for the canonical Pi resource installer."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


def main() -> int:
    installer = Path(__file__).resolve().with_name("sync-pi-resources")
    return subprocess.run([sys.executable, str(installer)], check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())


if __name__ == "__main__":
    raise SystemExit(main())
