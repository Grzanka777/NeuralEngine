class Qwen3CoderProfile(GeneralProfile):
    """Optional historical Qwen3-Coder local coding specialist profile."""

    model: Path = _QWEN3_CODER_DEFAULTS["model"]
    identity: str = _QWEN3_CODER_DEFAULTS["identity"]
    cli_alias: str = _QWEN3_CODER_DEFAULTS["cli_alias"]
    runtime: Path = _QWEN3_CODER_DEFAULTS["runtime"]
    host: str = _QWEN3_CODER_DEFAULTS["host"]
    port: int = _QWEN3_CODER_DEFAULTS["port"]
    runtime_args: tuple[str, ...] = _QWEN3_CODER_DEFAULTS["runtime_args"]
    runtime_ctx: int = _QWEN3_CODER_DEFAULTS["runtime_ctx"]
    device: str = _QWEN3_CODER_DEFAULTS["device"]
    mmproj: Path | None = _QWEN3_CODER_DEFAULTS["mmproj"]
    runtime_kind: str = _QWEN3_CODER_DEFAULTS["runtime_kind"]
    runtime_image: str | None = _QWEN3_CODER_DEFAULTS["runtime_image"]
    runtime_image_digest: str | None = _QWEN3_CODER_DEFAULTS["runtime_image_digest"]
    container_name: str | None = _QWEN3_CODER_DEFAULTS["container_name"]


@dataclass(frozen=True, slots=True)
class VisionProfile(GeneralProfile):
    """Current VISION deployment compatibility profile."""

    model: Path = _VISION_DEFAULTS["model"]
    identity: str = _VISION_DEFAULTS["identity"]
    cli_alias: str = _VISION_DEFAULTS["cli_alias"]
    runtime: Path = _VISION_DEFAULTS["runtime"]
    host: str = _VISION_DEFAULTS["host"]
    port: int = _VISION_DEFAULTS["port"]
    runtime_args: tuple[str, ...] = _VISION_DEFAULTS["runtime_args"]
    runtime_ctx: int = _VISION_DEFAULTS["runtime_ctx"]
    device: str = _VISION_DEFAULTS["device"]
    mmproj: Path | None = _VISION_DEFAULTS["mmproj"]


DEFAULT_PROFILE = GeneralProfile()
DEFAULT_CODE_PROFILE = CodeProfile()
DEFAULT_QWEN3_CODER_PROFILE = Qwen3CoderProfile()
DEFAULT_VISION_PROFILE = VisionProfile()
LEGACY_PROFILE_IDENTITIES = tuple(
    profile["legacy_identity"] for profile in RUNTIME_RECORDS.values()
)
CLI_PROFILE_ALIASES = tuple(profile["legacy_cli_alias"] for profile in RUNTIME_RECORDS.values())


def _expected_profile_identity(value: str | None) -> str | None:
    if value is None:
        return None
    normalized = value.upper()
    if normalized in LEGACY_PROFILE_IDENTITIES:
        return normalized
    profile_by_name = RUNTIME_RECORDS.get(value)
    if isinstance(profile_by_name, dict):
        return profile_by_name["legacy_identity"]
    role = MANIFEST["roles"].get(normalized)
    if isinstance(role, dict):
        profile = RUNTIME_RECORDS.get(role.get("current_deployment_profile"))
        if isinstance(profile, dict):
            return profile["legacy_identity"]
    for profile in RUNTIME_RECORDS.values():
        if value.lower() == profile["legacy_cli_alias"]:
            return profile["legacy_identity"]
    return None


@dataclass(frozen=True, slots=True)
class PortState:
    """Listening state and visible owning PIDs for one TCP port."""

    listening: bool
    pids: tuple[int, ...] = ()


def _local_port(address: str) -> int | None:
    if address.startswith("["):
        _, separator, port = address.rpartition("]:")
    else:
        _, separator, port = address.rpartition(":")
    if not separator:
        return None
    try:
        return int(port)
    except ValueError:
        return None


def _port_state_from_ss_output(output: str, port: int) -> PortState:
    pids: set[int] = set()
    listening = False

    for line in output.splitlines():
        fields = line.split()
        if len(fields) < 4 or fields[0] != "LISTEN":
            continue
        if _local_port(fields[3]) != port:
            continue

        listening = True
        pids.update(int(match) for match in _PID_PATTERN.findall(line))

    return PortState(listening=listening, pids=tuple(sorted(pids)))


def port_state(port: int) -> PortState:
    """Read one TCP listening port using Linux's standard ``ss`` utility."""

    try:
        result = subprocess.run(
            ["ss", "-H", "-ltnp"],
            capture_output=True,
            check=False,
            text=True,
        )
    except OSError as error:
        raise LauncherError(f"Cannot inspect TCP listeners with ss: {error}") from error

    if result.returncode != 0:
        detail = result.stderr.strip() or "ss returned a non-zero status"
        raise LauncherError(f"Cannot inspect TCP listeners: {detail}")

    return _port_state_from_ss_output(result.stdout, port)


def _process_command_line(pid: int) -> tuple[str, ...] | None:
    try:
        raw_command_line = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return None

    return tuple(
        item.decode("utf-8", errors="replace") for item in raw_command_line.split(b"\0") if item
    )


def _container_inspect(profile: GeneralProfile) -> dict[str, Any] | None:
    """Read one manager-owned container identity without changing its state."""

    if profile.runtime_kind != "podman" or not profile.container_name:
        return None
    try:
        result = subprocess.run(
            [str(profile.runtime), "inspect", profile.container_name],
            capture_output=True,
            check=False,
            text=True,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    try:
        records = json.loads(result.stdout)
    except TypeError, json.JSONDecodeError:
        return None
    if not isinstance(records, list) or len(records) != 1 or not isinstance(records[0], dict):
        return None
    return cast(dict[str, Any], records[0])


def _container_owner_pid(profile: GeneralProfile) -> int | None:
    """Return the exact running container init PID for a verified profile."""

    record = _container_inspect(profile)
    if record is None:
        return None
    state = record.get("State")
    config = record.get("Config")
    if not isinstance(state, dict) or not state.get("Running"):
        return None
    if not isinstance(config, dict):
        return None
    image_name = config.get("Image")
    image_name_alt = record.get("ImageName")
    image_id = str(record.get("Image", ""))
    expected_image_id = str(profile.runtime_image_digest or "")
    image_matches = image_name == profile.runtime_image or image_name_alt == profile.runtime_image
    if not image_matches and expected_image_id:
        image_matches = image_id.endswith(expected_image_id.removeprefix("sha256:"))
    if not image_matches:
        return None
    try:
        pid = int(state.get("Pid", 0))
    except TypeError, ValueError:
        return None
    return pid if pid > 0 else None


def _container_image_ready(profile: GeneralProfile) -> bool:
    """Require the pinned local image; never allow an implicit network pull."""

    if profile.runtime_kind != "podman" or not profile.runtime_image:
        return False
    try:
        result = subprocess.run(
            [str(profile.runtime), "image", "inspect", profile.runtime_image],
            capture_output=True,
            check=False,
            text=True,
        )
    except OSError:
        return False
    if result.returncode != 0:
        return False
    if not profile.runtime_image_digest:
        return True
    try:
        records = json.loads(result.stdout)
    except TypeError, json.JSONDecodeError:
        return False
    if not isinstance(records, list) or len(records) != 1 or not isinstance(records[0], dict):
        return False
    digests = records[0].get("RepoDigests", [])
    return any(
        isinstance(value, str) and value.endswith(f"@{profile.runtime_image_digest}")
        for value in digests
    )


def _profile_owner_pid(profile: GeneralProfile, state: PortState) -> int | None:
    if profile.runtime_kind == "podman":
        return _container_owner_pid(profile)
    if len(state.pids) == 1:
        return state.pids[0]
    return None


def is_general_process(pid: int, profile: GeneralProfile = DEFAULT_PROFILE) -> bool:
    """Verify the complete command line before allowing a stop."""

    return _process_command_line(pid) == profile.command()


def is_code_process(pid: int, profile: CodeProfile = DEFAULT_CODE_PROFILE) -> bool:
    """Verify the complete CODE command line before allowing a stop."""

    if profile.runtime_kind == "podman":
        owner_pid = _container_owner_pid(profile)
        return owner_pid is not None and (pid <= 0 or owner_pid == pid)
    return _process_command_line(pid) == profile.command()


def is_qwen3_coder_process(
    pid: int, profile: Qwen3CoderProfile = DEFAULT_QWEN3_CODER_PROFILE
) -> bool:
    """Verify the complete historical Qwen3-Coder command line before stopping."""

    return _process_command_line(pid) == profile.command()


def _health_ok(profile: GeneralProfile | CodeProfile | VisionProfile) -> bool:
    request = urllib.request.Request(
        f"http://{profile.host}:{profile.port}/health",
        method="GET",
    )
    try:
        with urllib.request.urlopen(  # noqa: S310 - localhost-only health check
            request,
            timeout=HEALTH_REQUEST_TIMEOUT_SECONDS,
        ) as response:
            return cast(int, response.status) == HTTPStatus.OK
    except OSError, TimeoutError, urllib.error.URLError:
        return False


def wait_for_health(
    profile: GeneralProfile | CodeProfile | VisionProfile = DEFAULT_PROFILE,
    *,
    timeout_seconds: float = HEALTH_TIMEOUT_SECONDS,
    poll_seconds: float = HEALTH_POLL_SECONDS,
    health_check: Callable[[], bool] | None = None,
    clock: Callable[[], float] = time.monotonic,
    sleeper: Callable[[float], Any] = time.sleep,
) -> bool:
    """Wait until ``/health`` returns HTTP 200 or the timeout expires."""

    check = health_check or (lambda: _health_ok(profile))
    deadline = clock() + timeout_seconds

    while True:
        if check():
            return True
        if clock() >= deadline:
            return False
        sleeper(poll_seconds)


def _state_log_path() -> Path:
    state_home = os.environ.get("XDG_STATE_HOME")
    root = Path(state_home) if state_home else Path.home() / ".local" / "state"
    return root / "llm" / "general.log"


def _code_log_path() -> Path:
    state_home = os.environ.get("XDG_STATE_HOME")
    root = Path(state_home) if state_home else Path.home() / ".local" / "state"
    return root / "llm" / "code.log"


def _lifecycle_lock_path() -> Path:
    state_home = os.environ.get("XDG_STATE_HOME")
    root = Path(state_home) if state_home else Path.home() / ".local" / "state"
    # Per-profile locks cannot serialize cross-entrypoint startup races.
    return root / "neuralengine" / LIFECYCLE_LOCK_FILENAME


@contextmanager
def lifecycle_lock(lock_path: Path | None = None) -> Any:
    """Serialize all production LLM lifecycle transitions with ``flock``."""

    selected_path = lock_path or _lifecycle_lock_path()
    try:
        selected_path.parent.mkdir(parents=True, exist_ok=True)
        with selected_path.open("a+") as lock_file:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
            try:
                yield
            finally:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
    except OSError as error:
        raise LauncherError(
            f"Cannot acquire LLM lifecycle lock {selected_path}: {error}"
        ) from error


def _terminate_started_process(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    process.terminate()
    with suppress(subprocess.TimeoutExpired):
        process.wait(timeout=5)


def _serve_foreground(
    profile: GeneralProfile | CodeProfile | VisionProfile,
    *,
    action: str,
    validate: Callable[[], None],
    port_reader: Callable[[int], PortState],
    process_replacer: Callable[[str, Sequence[str]], Any] | None,
    process_factory: Callable[..., subprocess.Popen[Any]] | None,
    health_waiter: Callable[[GeneralProfile | CodeProfile | VisionProfile], bool] | None,
    process_waiter: Callable[[subprocess.Popen[Any]], int | None] | None,
) -> None:
    """Run a foreground server after the shared startup lock reaches readiness.

    ``serve`` cannot ``exec`` directly while holding the lock: Python closes
    the lock descriptor during exec and the lock would not cover the bind
    window.  A small parent process instead holds the lock through health
    readiness, releases it, and waits for the server child for systemd.
    ``process_replacer`` remains a test seam for the historical exact-command
    assertions.
    """

    validate()

    def refuse_conflicts() -> None:
        conflicts = [port for port in CONFLICT_PORTS if port_reader(port).listening]
        if conflicts:
            raise LauncherError(
                f"{action} serve refused: a listener already occupies port(s): "
                + ", ".join(map(str, conflicts))
            )

    if process_replacer is not None:
        refuse_conflicts()
        try:
            process_replacer(str(profile.runtime), profile.command())
        except OSError as error:
            raise LauncherError(f"{action} serve failed to exec llama-server: {error}") from error
        return

    create_process = process_factory or subprocess.Popen
    wait_health = health_waiter or (lambda selected_profile: wait_for_health(selected_profile))
    with lifecycle_lock():
        refuse_conflicts()
        try:
            process = create_process(
                profile.command(),
                stdin=subprocess.DEVNULL,
                close_fds=True,
            )
        except OSError as error:
            raise LauncherError(f"{action} serve failed to launch llama-server: {error}") from error
        if not wait_health(profile):
            _terminate_started_process(process)
            raise LauncherError(
                f"{action} serve failed: /health did not become OK within "
                f"{HEALTH_TIMEOUT_SECONDS} seconds"
            )

    wait_process = process_waiter or (lambda selected_process: selected_process.wait())
    try:
        return_code = wait_process(process)
    except KeyboardInterrupt:
        _terminate_started_process(process)
        raise
    if return_code not in (None, 0):
        raise LauncherError(f"{action} serve exited with status {return_code}")


def detect_verified_running_profile(
    state: PortState,
    *,
    identity_checker: Callable[[int], bool],
    health_check: Callable[[], bool],
) -> int | None:
    """Return the verified PID when exactly one known-good process owns the port, else None.

    Returns the PID only when ALL three conditions hold:
    - exactly one visible PID owns the port,
    - the process command line matches the expected profile, and
    - the health endpoint reports healthy.

    Returns None for any deviation: unknown PID, multiple PIDs, cmdline mismatch,
    or unhealthy endpoint.  Callers must treat None as a refusal condition.
    """

    if len(state.pids) != 1:
        return None
    pid = state.pids[0]
    if not identity_checker(pid):
        return None
    if not health_check():
        return None
    return pid


def _validate_general_prerequisites(profile: GeneralProfile, action: str) -> None:
    for label, path in (
        ("model", profile.model),
        ("llama-server runtime", profile.runtime),
    ):
        if not path.is_file():
            raise LauncherError(f"GENERAL {action} refused: {label} does not exist: {path}")
    if not os.access(profile.runtime, os.X_OK):
        raise LauncherError(
            f"GENERAL {action} refused: runtime is not executable: {profile.runtime}"
        )


def start_general(
    profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    process_factory: Callable[..., subprocess.Popen[bytes]] | None = None,
    health_waiter: Callable[[GeneralProfile], bool] | None = None,
    log_path: Callable[[], Path] | None = None,
    identity_checker: Callable[[int, GeneralProfile], bool] | None = None,
    health_check: Callable[[GeneralProfile], bool] | None = None,
) -> None:
    """Validate, launch, and health-check the frozen GENERAL profile.

    Idempotent: if the exact verified GENERAL profile is already running and healthy,
    prints GENERAL ALREADY READY and returns without spawning a new process.
    """

    _validate_general_prerequisites(profile, "start")

    read_port = port_reader or port_state
    check_identity = identity_checker or is_general_process
    check_health = health_check or _health_ok

    # Idempotency: if the profile's own port is already occupied, check whether
    # it is the exact verified, healthy profile before running the full conflict scan.
    own_state = read_port(profile.port)
    if own_state.listening:
        verified_pid = detect_verified_running_profile(
            own_state,
            identity_checker=lambda pid: check_identity(pid, profile),
            health_check=lambda: check_health(profile),
        )
        if verified_pid is not None and not any(
            read_port(port).listening for port in CONFLICT_PORTS if port != profile.port
        ):
            print("GENERAL ALREADY READY")
            print(f"endpoint: {profile.endpoint()}")
            print(f"pid: {verified_pid}")
            return

    conflicts = [port for port in CONFLICT_PORTS if read_port(port).listening]
    if conflicts:
        formatted_ports = ", ".join(str(port) for port in conflicts)
        raise LauncherError(
            f"GENERAL start refused: a listener already occupies port(s): {formatted_ports}"
        )

    create_process = process_factory or subprocess.Popen
    target_log_path = log_path or _state_log_path
    log_file_path = target_log_path()
    try:
        log_file_path.parent.mkdir(parents=True, exist_ok=True)
        with log_file_path.open("ab") as log_file:
            process = create_process(
                profile.command(),
                stdin=subprocess.DEVNULL,
                stdout=log_file,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                close_fds=True,
            )
    except OSError as error:
        raise LauncherError(f"GENERAL start failed to launch llama-server: {error}") from error

    wait_health = health_waiter or (lambda selected_profile: wait_for_health(selected_profile))
    if not wait_health(profile):
        _terminate_started_process(process)
        raise LauncherError(
            "GENERAL start failed: /health did not become OK within "
            f"{HEALTH_TIMEOUT_SECONDS} seconds"
        )

    print("GENERAL READY")
    print(f"endpoint: {profile.endpoint()}")
    print(f"pid: {process.pid}")


def serve_general(
    profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    process_replacer: Callable[[str, Sequence[str]], Any] | None = None,
    process_factory: Callable[..., subprocess.Popen[Any]] | None = None,
    health_waiter: Callable[[GeneralProfile], bool] | None = None,
    process_waiter: Callable[[subprocess.Popen[Any]], int | None] | None = None,
) -> None:
    """Run the verified GENERAL profile in the foreground for systemd."""

    _serve_foreground(
        profile,
        action=profile.identity,
        validate=lambda: _validate_general_prerequisites(profile, "serve"),
        port_reader=port_reader or port_state,
        process_replacer=process_replacer,
        process_factory=process_factory,
        health_waiter=health_waiter,
        process_waiter=process_waiter,
    )


def _validate_qwen3_coder_prerequisites(profile: Qwen3CoderProfile, action: str) -> None:
    _validate_general_prerequisites(profile, action)


def _qwen3_coder_log_path() -> Path:
    return _code_log_path().with_name("qwen3-coder.log")


def start_qwen3_coder(
    profile: Qwen3CoderProfile = DEFAULT_QWEN3_CODER_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    process_factory: Callable[..., subprocess.Popen[bytes]] | None = None,
    health_waiter: Callable[[Qwen3CoderProfile], bool] | None = None,
    log_path: Callable[[], Path] | None = None,
    identity_checker: Callable[[int, Qwen3CoderProfile], bool] | None = None,
    health_check: Callable[[Qwen3CoderProfile], bool] | None = None,
) -> None:
    """Launch the optional historical Qwen3-Coder coding specialist profile."""

    _validate_qwen3_coder_prerequisites(profile, "start")
    read_port = port_reader or port_state
    check_identity = identity_checker or is_qwen3_coder_process
    check_health = health_check or _health_ok
    own_state = read_port(profile.port)
    if own_state.listening:
        verified_pid = detect_verified_running_profile(
            own_state,
            identity_checker=lambda pid: check_identity(pid, profile),
            health_check=lambda: check_health(profile),
        )
        if verified_pid is not None and not any(
            read_port(port).listening for port in CONFLICT_PORTS if port != profile.port
        ):
            print("QWEN3_CODER ALREADY READY")
            print(f"endpoint: {profile.endpoint()}")
            print(f"pid: {verified_pid}")
            return

    conflicts = [port for port in CONFLICT_PORTS if read_port(port).listening]
    if conflicts:
        raise LauncherError(
            "QWEN3_CODER start refused: a listener already occupies port(s): "
            + ", ".join(map(str, conflicts))
        )

    create_process = process_factory or subprocess.Popen
    target_log_path = log_path or _qwen3_coder_log_path
    log_file_path = target_log_path()
    try:
        log_file_path.parent.mkdir(parents=True, exist_ok=True)
        with log_file_path.open("ab") as log_file:
            process = create_process(
                profile.command(),
                stdin=subprocess.DEVNULL,
                stdout=log_file,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                close_fds=True,
            )
    except OSError as error:
        raise LauncherError(
            f"QWEN3_CODER start failed to launch llama-server: {error}"
        ) from error

    wait_health = health_waiter or (lambda selected_profile: wait_for_health(selected_profile))
    if not wait_health(profile):
        _terminate_started_process(process)
        raise LauncherError(
            "QWEN3_CODER start failed: /health did not become OK within "
            f"{HEALTH_TIMEOUT_SECONDS} seconds"
        )

    print("QWEN3_CODER READY")
    print(f"endpoint: {profile.endpoint()}")
    print(f"pid: {process.pid}")


def serve_qwen3_coder(
    profile: Qwen3CoderProfile = DEFAULT_QWEN3_CODER_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    process_replacer: Callable[[str, Sequence[str]], Any] | None = None,
    process_factory: Callable[..., subprocess.Popen[Any]] | None = None,
    health_waiter: Callable[[Qwen3CoderProfile], bool] | None = None,
    process_waiter: Callable[[subprocess.Popen[Any]], int | None] | None = None,
) -> None:
    """Run Qwen3-Coder in the foreground for an explicitly started unit."""

    _serve_foreground(
        profile,
        action=profile.identity,
        validate=lambda: _validate_qwen3_coder_prerequisites(profile, "serve"),
        port_reader=port_reader or port_state,
        process_replacer=process_replacer,
        process_factory=process_factory,
        health_waiter=health_waiter,
        process_waiter=process_waiter,
    )


def _validate_code_prerequisites(profile: CodeProfile, action: str) -> None:
    runtime_label = "podman runtime" if profile.runtime_kind == "podman" else "llama-server runtime"
    for label, path in (("model", profile.model), (runtime_label, profile.runtime)):
        if not path.is_file():
            raise LauncherError(f"CODE {action} refused: {label} does not exist: {path}")
    if not os.access(profile.runtime, os.X_OK):
        raise LauncherError(f"CODE {action} refused: runtime is not executable: {profile.runtime}")
    if profile.runtime_kind == "podman":
        if not profile.runtime_image or not profile.container_name:
            raise LauncherError(f"CODE {action} refused: container profile is incomplete")
        if not _container_image_ready(profile):
            raise LauncherError(
                "CODE "
                f"{action} refused: pinned runtime image is unavailable: {profile.runtime_image}"
            )


def _stop_code_container(
    profile: CodeProfile,
    *,
    expected_pid: int | None = None,
    closed_waiter: Callable[[int], bool] | None = None,
    port_reader: Callable[[int], PortState] = port_state,
) -> None:
    owner_pid = _container_owner_pid(profile)
    if owner_pid is None:
        raise LauncherError("CODE stop refused: verified Halogen container is not running")
    if expected_pid is not None and owner_pid != expected_pid:
        raise LauncherError(
            f"CODE stop refused: container ownership mismatch; expected PID {expected_pid}, "
            f"observed {owner_pid}"
        )
    try:
        result = subprocess.run(
            [str(profile.runtime), "stop", "--time", "10", profile.container_name or ""],
            capture_output=True,
            check=False,
            text=True,
        )
    except OSError as error:
        raise LauncherError(f"CODE stop failed for Halogen container: {error}") from error
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "podman stop failed"
        raise LauncherError(f"CODE stop failed for Halogen container: {detail}")
    wait_closed = closed_waiter or (
        lambda selected_port: wait_for_port_closed(selected_port, port_reader=port_reader)
    )
    if not wait_closed(profile.port):
        raise LauncherError(f"CODE stop failed: port {profile.port} is still listening")
    print("CODE STOPPED")
    print(f"port {profile.port}: closed")


def start_code(
    profile: CodeProfile = DEFAULT_CODE_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    process_factory: Callable[..., subprocess.Popen[bytes]] | None = None,
    health_waiter: Callable[[CodeProfile], bool] | None = None,
    log_path: Callable[[], Path] | None = None,
    identity_checker: Callable[[int, CodeProfile], bool] | None = None,
    health_check: Callable[[CodeProfile], bool] | None = None,
) -> None:
    """Launch CODE only when no other local profile owns a conflict port."""

    _validate_code_prerequisites(profile, "start")
    read_port = port_reader or port_state
    check_identity = identity_checker or is_code_process
    check_health = health_check or _health_ok
    own_state = read_port(profile.port)
    if own_state.listening:
        if profile.runtime_kind == "podman":
            candidate_pid = _container_owner_pid(profile)
            verified_pid = candidate_pid if candidate_pid and check_health(profile) else None
        else:
            verified_pid = detect_verified_running_profile(
                own_state,
                identity_checker=lambda pid: check_identity(pid, profile),
                health_check=lambda: check_health(profile),
            )
        if verified_pid is not None and not any(
            read_port(port).listening for port in CONFLICT_PORTS if port != profile.port
        ):
            print("CODE ALREADY READY")
            print(f"endpoint: {profile.endpoint()}")
            print(f"pid: {verified_pid}")
            return

    conflicts = [port for port in CONFLICT_PORTS if read_port(port).listening]
    if conflicts:
        raise LauncherError(
            "CODE start refused: a listener already occupies port(s): "
            + ", ".join(map(str, conflicts))
        )

    if profile.runtime_kind == "podman":
        try:
            result = subprocess.run(
                profile.command(),
                capture_output=True,
                check=False,
                text=True,
            )
        except OSError as error:
            raise LauncherError(f"CODE start failed to launch Halogen: {error}") from error
        if result.returncode != 0:
            detail = result.stderr.strip() or result.stdout.strip() or "podman run failed"
            raise LauncherError(f"CODE start failed to launch Halogen: {detail}")
        wait_health = health_waiter or (lambda selected_profile: wait_for_health(selected_profile))
        if not wait_health(profile):
            with suppress(LauncherError):
                _stop_code_container(profile, port_reader=read_port)
            raise LauncherError(
                "CODE start failed: /health did not become OK within "
                f"{HEALTH_TIMEOUT_SECONDS} seconds"
            )
        owner_pid = _container_owner_pid(profile)
        if owner_pid is None:
            with suppress(LauncherError):
                _stop_code_container(profile, port_reader=read_port)
            raise LauncherError(
                "CODE start failed: exact Halogen container identity was not verified"
            )
        print("CODE READY")
        print(f"endpoint: {profile.endpoint()}")
        print(f"pid: {owner_pid}")
        return

    create_process = process_factory or subprocess.Popen
    target_log_path = log_path or _code_log_path
    log_file_path = target_log_path()
    try:
        log_file_path.parent.mkdir(parents=True, exist_ok=True)
        with log_file_path.open("ab") as log_file:
            process = create_process(
                profile.command(),
                stdin=subprocess.DEVNULL,
                stdout=log_file,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                close_fds=True,
            )
    except OSError as error:
        raise LauncherError(f"CODE start failed to launch llama-server: {error}") from error

    wait_health = health_waiter or (lambda selected_profile: wait_for_health(selected_profile))
    if not wait_health(profile):
        _terminate_started_process(process)
        raise LauncherError(
            f"CODE start failed: /health did not become OK within {HEALTH_TIMEOUT_SECONDS} seconds"
        )

    print("CODE READY")
    print(f"endpoint: {profile.endpoint()}")
    print(f"pid: {process.pid}")


def serve_code(
    profile: CodeProfile = DEFAULT_CODE_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    process_replacer: Callable[[str, Sequence[str]], Any] | None = None,
    process_factory: Callable[..., subprocess.Popen[Any]] | None = None,
    health_waiter: Callable[[CodeProfile], bool] | None = None,
    process_waiter: Callable[[subprocess.Popen[Any]], int | None] | None = None,
) -> None:
    """Run CODE in the foreground for an explicitly started systemd unit."""

    if profile.runtime_kind == "podman":
        raise LauncherError("CODE serve is unsupported for the detached Halogen profile; use start")

    _serve_foreground(
        profile,
        action=profile.identity,
        validate=lambda: _validate_code_prerequisites(profile, "serve"),
        port_reader=port_reader or port_state,
        process_replacer=process_replacer,
        process_factory=process_factory,
        health_waiter=health_waiter,
        process_waiter=process_waiter,
    )


def _validate_vision_prerequisites(profile: VisionProfile, action: str) -> None:
    _validate_code_prerequisites(profile, action)
    if not profile.mmproj.is_file():
        raise LauncherError(f"VISION {action} refused: mmproj does not exist: {profile.mmproj}")


def is_vision_process(pid: int, profile: VisionProfile = DEFAULT_VISION_PROFILE) -> bool:
    return _process_command_line(pid) == profile.command()


def _vision_log_path() -> Path:
    return _code_log_path().with_name("vision.log")


def start_vision(
    profile: VisionProfile = DEFAULT_VISION_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
