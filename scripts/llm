#!/usr/bin/env python3
"""Sole local runtime manager for current deployment compatibility profiles."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from io import StringIO
from collections.abc import Callable, Sequence
from contextlib import contextmanager, redirect_stdout, suppress
from dataclasses import dataclass
from http import HTTPStatus
from pathlib import Path
from typing import Any, cast

REPO_ROOT = Path(__file__).resolve().parent.parent
MANIFEST_PATH = REPO_ROOT / "llm-manifest.json"


def _load_manifest() -> dict[str, Any]:
    try:
        manifest = json.loads(MANIFEST_PATH.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise RuntimeError(f"cannot load canonical local model manifest: {error}") from error
    if not isinstance(manifest, dict) or manifest.get("schema_version") != 2:
        raise RuntimeError(f"unsupported canonical local model manifest: {MANIFEST_PATH}")
    return manifest


MANIFEST = _load_manifest()
MODEL_RECORDS: dict[str, dict[str, Any]] = MANIFEST["models"]
RUNTIME_RECORDS: dict[str, dict[str, Any]] = MANIFEST["runtime_profiles"]


def _profile_defaults(name: str) -> dict[str, Any]:
    profile = RUNTIME_RECORDS[name]
    model = MODEL_RECORDS[profile["model_ref"]]
    projector_ref = profile.get("projector_ref")
    projector = MODEL_RECORDS[projector_ref]["artifact_path"] if projector_ref else None
    endpoint = profile["endpoint"]
    runtime = profile["runtime"]
    return {
        "identity": profile["legacy_identity"],
        "cli_alias": profile["legacy_cli_alias"],
        "model": Path(model["artifact_path"]),
        "runtime": Path(runtime["binary"]),
        "host": endpoint["host"],
        "port": endpoint["port"],
        "runtime_args": tuple(profile["arguments"]),
        "runtime_ctx": profile["context_layers"]["runtime_ctx"],
        "device": runtime["device"],
        "mmproj": Path(projector) if projector else None,
        "runtime_kind": runtime.get("kind", "binary"),
        "runtime_image": runtime.get("image"),
        "runtime_image_digest": runtime.get("image_digest"),
        "container_name": runtime.get("container_name"),
    }


_GENERAL_DEFAULTS = _profile_defaults("current-general")
_CODE_DEFAULTS = _profile_defaults("current-code")
_QWEN3_CODER_DEFAULTS = _profile_defaults("current-qwen3-coder")
_VISION_DEFAULTS = _profile_defaults("current-vision")
GENERAL_MODEL = _GENERAL_DEFAULTS["model"]
CODE_MODEL = _CODE_DEFAULTS["model"]
VISION_MODEL = _VISION_DEFAULTS["model"]
VISION_MMPROJ = _VISION_DEFAULTS["mmproj"]
LLAMA_SERVER = _GENERAL_DEFAULTS["runtime"]
GENERAL_HOST = _GENERAL_DEFAULTS["host"]
GENERAL_PORT = _GENERAL_DEFAULTS["port"]
CODE_HOST = _CODE_DEFAULTS["host"]
CODE_PORT = _CODE_DEFAULTS["port"]
VISION_HOST = _VISION_DEFAULTS["host"]
VISION_PORT = _VISION_DEFAULTS["port"]
QWEN3_CODER_HOST = _QWEN3_CODER_DEFAULTS["host"]
QWEN3_CODER_PORT = _QWEN3_CODER_DEFAULTS["port"]
CONFLICT_PORTS = tuple(
    sorted(
        {GENERAL_PORT, CODE_PORT, QWEN3_CODER_PORT, VISION_PORT}
        | set(MANIFEST.get("reserved_conflict_ports", []))
    )
)
HEALTH_TIMEOUT_SECONDS = 300
HEALTH_POLL_SECONDS = 1
HEALTH_REQUEST_TIMEOUT_SECONDS = 2
STOP_TIMEOUT_SECONDS = 90
STOP_POLL_SECONDS = 1
LIFECYCLE_LOCK_FILENAME = "lifecycle.lock"
_PID_PATTERN = re.compile(r"\bpid=(\d+)\b")


class LauncherError(RuntimeError):
    """A safe, user-facing launcher failure."""


@dataclass(frozen=True, slots=True)
class GeneralProfile:
    """A validated current-deployment compatibility profile from the manifest."""

    model: Path = _GENERAL_DEFAULTS["model"]
    identity: str = _GENERAL_DEFAULTS["identity"]
    cli_alias: str = _GENERAL_DEFAULTS["cli_alias"]
    runtime: Path = _GENERAL_DEFAULTS["runtime"]
    host: str = _GENERAL_DEFAULTS["host"]
    port: int = _GENERAL_DEFAULTS["port"]
    runtime_args: tuple[str, ...] = _GENERAL_DEFAULTS["runtime_args"]
    runtime_ctx: int = _GENERAL_DEFAULTS["runtime_ctx"]
    device: str = _GENERAL_DEFAULTS["device"]
    mmproj: Path | None = _GENERAL_DEFAULTS["mmproj"]
    runtime_kind: str = _GENERAL_DEFAULTS["runtime_kind"]
    runtime_image: str | None = _GENERAL_DEFAULTS["runtime_image"]
    runtime_image_digest: str | None = _GENERAL_DEFAULTS["runtime_image_digest"]
    container_name: str | None = _GENERAL_DEFAULTS["container_name"]

    def arguments(self) -> tuple[str, ...]:
        values = {
            "model_path": str(self.model),
            "projector_path": str(self.mmproj) if self.mmproj is not None else "",
            "device": self.device,
            "runtime_ctx": str(self.runtime_ctx),
            "host": self.host,
            "port": str(self.port),
        }
        return tuple(argument.format_map(values) for argument in self.runtime_args)

    def command(self) -> tuple[str, ...]:
        return (str(self.runtime), *self.arguments())

    def endpoint(self) -> str:
        return f"http://{self.host}:{self.port}/v1"


@dataclass(frozen=True, slots=True)
class CodeProfile(GeneralProfile):
    """Current CODE deployment compatibility profile."""

    model: Path = _CODE_DEFAULTS["model"]
    identity: str = _CODE_DEFAULTS["identity"]
    cli_alias: str = _CODE_DEFAULTS["cli_alias"]
    runtime: Path = _CODE_DEFAULTS["runtime"]
    host: str = _CODE_DEFAULTS["host"]
    port: int = _CODE_DEFAULTS["port"]
    runtime_args: tuple[str, ...] = _CODE_DEFAULTS["runtime_args"]
    runtime_ctx: int = _CODE_DEFAULTS["runtime_ctx"]
    device: str = _CODE_DEFAULTS["device"]
    mmproj: Path | None = _CODE_DEFAULTS["mmproj"]
    runtime_kind: str = _CODE_DEFAULTS["runtime_kind"]
    runtime_image: str | None = _CODE_DEFAULTS["runtime_image"]
    runtime_image_digest: str | None = _CODE_DEFAULTS["runtime_image_digest"]
    container_name: str | None = _CODE_DEFAULTS["container_name"]


