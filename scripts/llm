VISION_HOST = "127.0.0.1"
VISION_PORT = 18082
CONFLICT_PORTS = (18080, 18081, 18082, 18084)
HEALTH_TIMEOUT_SECONDS = 300
HEALTH_POLL_SECONDS = 1
HEALTH_REQUEST_TIMEOUT_SECONDS = 2
STOP_TIMEOUT_SECONDS = 90
STOP_POLL_SECONDS = 1
LIFECYCLE_LOCK_FILENAME = "lifecycle.lock"
_PID_PATTERN = re.compile(r"\bpid=(\d+)\b")


class LauncherError(RuntimeError):
    """A safe, user-facing launcher failure."""


@dataclass(frozen=True, slots=True)
class GeneralProfile:
    """The immutable production GENERAL profile."""

    model: Path = GENERAL_MODEL
    mtp: Path = GENERAL_MTP
    runtime: Path = LLAMA_SERVER
    host: str = GENERAL_HOST
    port: int = GENERAL_PORT

    def arguments(self) -> tuple[str, ...]:
        """Return the frozen llama-server arguments after the executable."""

        return (
            "-m",
            str(self.model),
            "-dev",
            "Vulkan0",
            "-ngl",
            "999",
            "-c",
            "32768",
            "-b",
            "2048",
            "-ub",
            "1024",
            "-np",
            "1",
            "-fa",
            "on",
            "--cache-prompt",
            "--spec-type",
            "draft-mtp",
            "--spec-draft-model",
            str(self.mtp),
            "--spec-draft-device",
            "Vulkan0",
            "--spec-draft-ngl",
            "999",
            "--spec-draft-n-max",
            "3",
            "--metrics",
            "--host",
            self.host,
            "--port",
            str(self.port),
        )

    def command(self) -> tuple[str, ...]:
        """Return the complete frozen command line."""

        return (str(self.runtime), *self.arguments())

    def endpoint(self) -> str:
        """Return the OpenAI-compatible endpoint."""

        return f"http://{self.host}:{self.port}/v1"


DEFAULT_PROFILE = GeneralProfile()


