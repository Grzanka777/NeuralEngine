        port_reader=port_reader or port_state,
        process_replacer=process_replacer,
        process_factory=process_factory,
        health_waiter=health_waiter,
        process_waiter=process_waiter,
    )


def wait_for_port_closed(
    port: int,
    *,
    port_reader: Callable[[int], PortState] = port_state,
    timeout_seconds: float = STOP_TIMEOUT_SECONDS,
    poll_seconds: float = STOP_POLL_SECONDS,
    clock: Callable[[], float] = time.monotonic,
    sleeper: Callable[[float], Any] = time.sleep,
) -> bool:
    """Wait until a TCP port no longer has a listener."""

    deadline = clock() + timeout_seconds
    while True:
        if not port_reader(port).listening:
            return True
        if clock() >= deadline:
            return False
        sleeper(poll_seconds)


def stop_general(
    profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    identity_checker: Callable[[int, GeneralProfile], bool] | None = None,
    killer: Callable[[int, int], Any] | None = None,
    closed_waiter: Callable[[int], bool] | None = None,
) -> None:
    """Stop only the verified GENERAL process that owns port 18081."""

    read_port = port_reader or port_state
    state = read_port(profile.port)
    if not state.listening:
        print("GENERAL STOPPED")
        print(f"port {profile.port}: closed")
        return

    if len(state.pids) != 1:
        raise LauncherError(
            f"GENERAL stop refused: owner of port {profile.port} is ambiguous "
            f"(visible PIDs: {', '.join(map(str, state.pids)) or 'unknown'})"
        )

    pid = state.pids[0]
    check_identity = identity_checker or is_general_process
    if not check_identity(pid, profile):
        raise LauncherError(f"GENERAL stop refused: PID {pid} is not the verified GENERAL profile")

    send_signal = killer or os.kill
    try:
        send_signal(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except OSError as error:
        raise LauncherError(f"GENERAL stop failed for verified PID {pid}: {error}") from error

    wait_closed = closed_waiter or (
        lambda selected_port: wait_for_port_closed(selected_port, port_reader=read_port)
    )
    if not wait_closed(profile.port):
        raise LauncherError(f"GENERAL stop failed: port {profile.port} is still listening")

    print("GENERAL STOPPED")
    print(f"port {profile.port}: closed")


def _stop_verified_profile(
    profile_name: str,
    profile: Any,
    state: PortState,
    *,
    port_reader: Callable[[int], PortState],
    identity_checker: Callable[[int, Any], bool],
    killer: Callable[[int, int], Any] | None = None,
    closed_waiter: Callable[[int], bool] | None = None,
) -> None:
    if (
        getattr(profile, "runtime_kind", "binary") == "podman"
        and identity_checker is is_code_process
    ):
        if not isinstance(profile, CodeProfile):
            raise LauncherError(f"{profile_name} stop refused: unsupported container profile")
        _stop_code_container(
            profile,
            closed_waiter=closed_waiter,
            port_reader=port_reader,
        )
        return

    if len(state.pids) != 1:
        raise LauncherError(
            f"{profile_name} stop refused: owner of port {profile.port} is ambiguous "
            f"(visible PIDs: {', '.join(map(str, state.pids)) or 'unknown'})"
        )

    pid = state.pids[0]
    if not identity_checker(pid, profile):
        raise LauncherError(
            f"{profile_name} stop refused: PID {pid} is not the verified {profile_name} profile"
        )

    send_signal = killer or os.kill
    try:
        send_signal(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except OSError as error:
        raise LauncherError(
            f"{profile_name} stop failed for verified PID {pid}: {error}"
        ) from error

    wait_closed = closed_waiter or (
        lambda selected_port: wait_for_port_closed(selected_port, port_reader=port_reader)
    )
    if not wait_closed(profile.port):
        raise LauncherError(f"{profile_name} stop failed: port {profile.port} is still listening")

    print(f"{profile_name} STOPPED")
    print(f"port {profile.port}: closed")


def _print_status_pid(state: PortState) -> None:
    if len(state.pids) == 1:
        print(f"pid: {state.pids[0]}")
    elif state.pids:
        print(f"pid: ambiguous ({', '.join(map(str, state.pids))})")
    else:
        print("pid: unknown (ss did not expose the owner)")


def status_profiles(
    general_profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    code_profile: CodeProfile = DEFAULT_CODE_PROFILE,
    qwen3_coder_profile: Qwen3CoderProfile = DEFAULT_QWEN3_CODER_PROFILE,
    vision_profile: VisionProfile = DEFAULT_VISION_PROFILE,
    port_reader: Callable[[int], PortState] | None = None,
    general_health_check: Callable[[GeneralProfile], bool] | None = None,
    general_identity_checker: Callable[[int, GeneralProfile], bool] | None = None,
    code_health_check: Callable[[CodeProfile], bool] | None = None,
    qwen3_coder_health_check: Callable[[Qwen3CoderProfile], bool] | None = None,
    vision_health_check: Callable[[VisionProfile], bool] | None = None,
    code_identity_checker: Callable[[int, CodeProfile], bool] | None = None,
    qwen3_coder_identity_checker: Callable[[int, Qwen3CoderProfile], bool] | None = None,
    vision_identity_checker: Callable[[int, VisionProfile], bool] | None = None,
) -> None:
    """Report supported profile state without changing any process state."""

    read_port = port_reader or port_state
    states = {port: read_port(port) for port in CONFLICT_PORTS}
    active_ports = [port for port, state in states.items() if state.listening]
    if not active_ports:
        print("LLM STOPPED")
        print("profile: none")
        print("active port: none")
        print("health: unavailable")
        print("pid: not running")
        return

    if len(active_ports) != 1:
        print("profile: CONFLICT")
        print(f"active ports: {', '.join(map(str, sorted(active_ports)))}")
        return

    port = active_ports[0]
    if port == general_profile.port:
        name: str = general_profile.identity
        profile: GeneralProfile | CodeProfile | VisionProfile = general_profile
        identity_check = general_identity_checker or is_general_process
        health_check = general_health_check or _health_ok
    elif port == code_profile.port:
        name = code_profile.identity
        profile = code_profile
        identity_check = code_identity_checker or is_code_process
        health_check = code_health_check or _health_ok
    elif port == qwen3_coder_profile.port:
        name = qwen3_coder_profile.identity
        profile = qwen3_coder_profile
        identity_check = qwen3_coder_identity_checker or is_qwen3_coder_process
        health_check = qwen3_coder_health_check or _health_ok
    elif port == vision_profile.port:
        name = vision_profile.identity
        profile = vision_profile
        identity_check = vision_identity_checker or is_vision_process
        health_check = vision_health_check or _health_ok
    else:
        print("profile: UNKNOWN")
        print(f"active port: {port}")
        _print_status_pid(states[port])
        return

    state = states[port]
    if profile.runtime_kind == "podman" and code_identity_checker is None:
        owner_pid = _container_owner_pid(profile)
        identifiable = owner_pid is not None
    else:
        owner_pid = state.pids[0] if len(state.pids) == 1 else None
        identifiable = owner_pid is not None and identity_check(owner_pid, profile)
    print(f"profile: {name if identifiable else 'unknown'}")
    print(f"active port: {profile.port}")
    print(f"port {profile.port}: listening")
    print(f"health: {'OK' if health_check(profile) else 'not OK or unavailable'}")
    if profile.runtime_kind == "podman" and owner_pid is not None:
        print(f"pid: {owner_pid}")
    else:
        _print_status_pid(state)


def active_profile_state(
    general_profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    code_profile: CodeProfile = DEFAULT_CODE_PROFILE,
    qwen3_coder_profile: Qwen3CoderProfile = DEFAULT_QWEN3_CODER_PROFILE,
    vision_profile: VisionProfile = DEFAULT_VISION_PROFILE,
    port_reader: Callable[[int], PortState] | None = None,
    general_health_check: Callable[[GeneralProfile], bool] | None = None,
    general_identity_checker: Callable[[int, GeneralProfile], bool] | None = None,
    code_health_check: Callable[[CodeProfile], bool] | None = None,
    qwen3_coder_health_check: Callable[[Qwen3CoderProfile], bool] | None = None,
    vision_health_check: Callable[[VisionProfile], bool] | None = None,
    code_identity_checker: Callable[[int, CodeProfile], bool] | None = None,
    qwen3_coder_identity_checker: Callable[[int, Qwen3CoderProfile], bool] | None = None,
    vision_identity_checker: Callable[[int, VisionProfile], bool] | None = None,
) -> str:
    """Return one exact, machine-readable verified production state.

    ``UNKNOWN`` is returned for every state that cannot be proven to be one
    healthy, uniquely owned frozen profile.  The wrapper uses this as a
    fail-closed ownership boundary.
    """

    read_port = port_reader or port_state
    if not any(read_port(port).listening for port in CONFLICT_PORTS):
        return "STOPPED"
    identity = active_profile_identity(
        general_profile,
        code_profile=code_profile,
        qwen3_coder_profile=qwen3_coder_profile,
        vision_profile=vision_profile,
        port_reader=read_port,
        general_health_check=general_health_check,
        general_identity_checker=general_identity_checker,
        code_health_check=code_health_check,
        qwen3_coder_health_check=qwen3_coder_health_check,
        vision_health_check=vision_health_check,
        code_identity_checker=code_identity_checker,
        qwen3_coder_identity_checker=qwen3_coder_identity_checker,
        vision_identity_checker=vision_identity_checker,
    )
    return identity[0] if identity is not None else "UNKNOWN"


def active_profile_identity(
    general_profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    code_profile: CodeProfile = DEFAULT_CODE_PROFILE,
    qwen3_coder_profile: Qwen3CoderProfile = DEFAULT_QWEN3_CODER_PROFILE,
    vision_profile: VisionProfile = DEFAULT_VISION_PROFILE,
    port_reader: Callable[[int], PortState] | None = None,
    general_health_check: Callable[[GeneralProfile], bool] | None = None,
    general_identity_checker: Callable[[int, GeneralProfile], bool] | None = None,
    code_health_check: Callable[[CodeProfile], bool] | None = None,
    qwen3_coder_health_check: Callable[[Qwen3CoderProfile], bool] | None = None,
    vision_health_check: Callable[[VisionProfile], bool] | None = None,
    code_identity_checker: Callable[[int, CodeProfile], bool] | None = None,
    qwen3_coder_identity_checker: Callable[[int, Qwen3CoderProfile], bool] | None = None,
    vision_identity_checker: Callable[[int, VisionProfile], bool] | None = None,
) -> tuple[str, int] | None:
    """Return the exact verified active profile and PID, or ``None``."""

    read_port = port_reader or port_state
    states = {port: read_port(port) for port in CONFLICT_PORTS}
    active_ports = [port for port, state in states.items() if state.listening]
    if len(active_ports) != 1:
        return None
    port = active_ports[0]
    if port == general_profile.port:
        name = "GENERAL"
        profile: GeneralProfile | CodeProfile | VisionProfile = general_profile
        identity_check = general_identity_checker or is_general_process
        health_check = general_health_check or _health_ok
    elif port == code_profile.port:
        name = "CODE"
        profile = code_profile
        identity_check = code_identity_checker or is_code_process
        health_check = code_health_check or _health_ok
    elif port == qwen3_coder_profile.port:
        name = "QWEN3_CODER"
        profile = qwen3_coder_profile
        identity_check = qwen3_coder_identity_checker or is_qwen3_coder_process
        health_check = qwen3_coder_health_check or _health_ok
    elif port == vision_profile.port:
        name = "VISION"
        profile = vision_profile
        identity_check = vision_identity_checker or is_vision_process
        health_check = vision_health_check or _health_ok
    else:
        return None
    if profile.runtime_kind == "podman" and code_identity_checker is None:
        verified_pid = _container_owner_pid(profile)
        if verified_pid is not None and not health_check(profile):
            verified_pid = None
    else:
        verified_pid = detect_verified_running_profile(
            states[port],
            identity_checker=lambda pid: identity_check(pid, profile),
            health_check=lambda: health_check(profile),
        )
    if verified_pid is None:
        return None
    return name, verified_pid


def machine_profile_identity() -> str:
    """Return ``PROFILE PID``, ``STOPPED``, or ``UNKNOWN`` for automation."""

    state = active_profile_state()
    if state == "STOPPED":
        return "STOPPED"
    identity = active_profile_identity()
    if identity is None:
        return "UNKNOWN"
    profile_name, pid = identity
    return f"{profile_name} {pid}"


def project_role(role_name: str) -> dict[str, Any]:
    """Resolve a client route from a LOCAL_* role without changing runtime state."""

    role = MANIFEST["roles"].get(role_name)
    if not isinstance(role, dict) or role.get("assignment") != "UNDECIDED":
        raise LauncherError(f"project refused: unknown or assigned local role {role_name!r}")
    profile_name = role.get("current_deployment_profile")
    profile = RUNTIME_RECORDS.get(profile_name)
    if not isinstance(profile, dict):
        raise LauncherError(f"project refused: missing compatibility profile for {role_name}")
    model = MODEL_RECORDS[profile["model_ref"]]
    layers = profile["context_layers"]
    model_max_ctx = model["model_max_ctx"]["tokens"]
    return {
        "role": role_name,
        "assignment": role["assignment"],
        "projection_status": role["projection_status"],
        "profile": profile_name,
        "model_id": model["model_id"],
        "display_name": model["display_name"],
        "endpoint": (
            f"http://{profile['endpoint']['host']}:{profile['endpoint']['port']}"
            f"{profile['endpoint']['path']}"
        ),
        "runtime": profile["runtime"],
        "context_layers": layers,
        "model_max_ctx": model_max_ctx,
        "runtime_ctx": layers["runtime_ctx"],
        "slot_ctx": layers["slot_ctx"],
        "client_effective_ctx": layers["client_effective_ctx"],
        "max_output_tokens": profile["max_output_tokens"],
    }


def project_profile(profile_name: str) -> dict[str, Any]:
    """Resolve one manifest runtime profile without changing runtime state."""

    identity = _expected_profile_identity(profile_name)
    if identity is None:
        raise LauncherError(f"project refused: unknown runtime profile {profile_name!r}")
    profile = next(
        (
            record
            for record in RUNTIME_RECORDS.values()
            if record.get("legacy_identity") == identity
        ),
        None,
    )
    if not isinstance(profile, dict):
        raise LauncherError(f"project refused: missing runtime profile for {profile_name!r}")
    model = MODEL_RECORDS[profile["model_ref"]]
    endpoint = profile["endpoint"]
    layers = profile["context_layers"]
    return {
        "profile": next(
            name for name, record in RUNTIME_RECORDS.items() if record is profile
        ),
        "identity": identity,
        "model_id": model["model_id"],
        "display_name": model["display_name"],
        "endpoint": f"http://{endpoint['host']}:{endpoint['port']}{endpoint['path']}",
        "runtime": profile["runtime"],
        "context_layers": layers,
        "model_max_ctx": model["model_max_ctx"]["tokens"],
        "runtime_ctx": layers["runtime_ctx"],
        "slot_ctx": layers["slot_ctx"],
        "client_effective_ctx": layers["client_effective_ctx"],
        "max_output_tokens": profile["max_output_tokens"],
        "selection_status": profile.get("selection_status", "CURRENT_DEPLOYMENT"),
    }


def switch_json(target: str) -> None:
    """Start one profile and emit a strict Pi lifecycle ownership document."""

    target_identity = _expected_profile_identity(target)
    if target_identity is None:
        raise LauncherError(f"SWITCH FAILED: unsupported target profile: {target}")
    with redirect_stdout(StringIO()):
        identity = start_profile(target)
    observed = active_profile_identity()
    if observed is None or observed[0] != target_identity:
        raise LauncherError("SWITCH FAILED: target profile was not verified READY")
    document = {
        "api_version": 1,
        "operation": "switch",
        "profile": target_identity,
        "pid": observed[1],
        "endpoint": project_profile(target)["endpoint"],
        "ownership": "STARTED" if identity is not None else "BORROWED",
    }
    print(json.dumps(document, sort_keys=True))


def stop_owned_json(expected_profile: str, expected_pid: int) -> None:
    """Stop only the exact profile/PID previously returned as STARTED."""

    expected_identity = _expected_profile_identity(expected_profile)
    if expected_identity is None or expected_pid <= 0:
        raise LauncherError("stop-owned refused: expected profile and positive PID are required")
    with lifecycle_lock():
        observed = active_profile_identity()
        if observed != (expected_identity, expected_pid):
            print(
                json.dumps(
                    {
                        "api_version": 1,
                        "operation": "stop_owned",
                        "result": "NOT_OWNED_OR_REPLACED",
                        "profile": expected_identity,
                        "pid": expected_pid,
                    },
                    sort_keys=True,
                )
            )
            return
        with redirect_stdout(StringIO()):
            stop_active_profiles(
                expected_profile=expected_identity,
                expected_pid=expected_pid,
            )
        print(
            json.dumps(
                {
                    "api_version": 1,
                    "operation": "stop_owned",
                    "result": "STOPPED",
                    "profile": expected_identity,
                    "pid": expected_pid,
                },
                sort_keys=True,
            )
        )


def switch_profile(
    target: str,
    *,
    state_reader: Callable[[], str] | None = None,
    stopper: Callable[[], None] | None = None,
    starter: Callable[[], None] | None = None,
    lock_path: Path | None = None,
) -> None:
    """Switch between verified production profiles while holding the lifecycle lock."""

    target_name = _expected_profile_identity(target)
    if target_name not in LEGACY_PROFILE_IDENTITIES:
        raise LauncherError(f"SWITCH FAILED: unsupported target profile: {target}")

    read_state = state_reader or active_profile_state

    def stop_current() -> None:
        if stopper is not None:
            stopper()
            return
        identity = active_profile_identity()
        if identity is None:
            raise LauncherError("switch refused: active ownership could not be verified")
        stop_active_profiles(expected_profile=identity[0], expected_pid=identity[1])

    start_target = (
        starter
        or {
            _GENERAL_DEFAULTS["identity"]: start_general,
            _CODE_DEFAULTS["identity"]: start_code,
            _QWEN3_CODER_DEFAULTS["identity"]: start_qwen3_coder,
            _VISION_DEFAULTS["identity"]: start_vision,
        }[target_name]
    )

    with lifecycle_lock(lock_path):
        current = read_state()
        if current == "UNKNOWN":
            raise LauncherError(
                "SWITCH FAILED: current LLM state is UNKNOWN; refusing to stop or start"
            )
        if current == target_name:
            print(f"{target_name} ALREADY READY")
            return
        if current not in {"STOPPED", *LEGACY_PROFILE_IDENTITIES}:
            raise LauncherError(f"SWITCH FAILED: unsupported current LLM state: {current}")

        try:
            if current != "STOPPED":
                stop_current()
                if read_state() != "STOPPED":
                    raise LauncherError(
                        f"old profile {current} did not reach verified STOPPED state"
                    )

            start_target()
            if read_state() != target_name:
                raise LauncherError(f"target profile {target_name} was not verified READY")
        except LauncherError as error:
            message = str(error)
            if message.startswith("SWITCH FAILED:"):
                raise
            raise LauncherError(f"SWITCH FAILED: {message}") from error


def start_profile(
    target: str,
    *,
    state_reader: Callable[[], str] | None = None,
    starter: Callable[[], None] | None = None,
    identity_reader: Callable[[], tuple[str, int] | None] | None = None,
    lock_path: Path | None = None,
) -> tuple[str, int] | None:
    """Start only from STOPPED; return identity only when this call started it."""

    target_name = _expected_profile_identity(target)
    if target_name not in LEGACY_PROFILE_IDENTITIES:
        raise LauncherError(f"START REFUSED: unsupported target profile: {target}")

    read_state = state_reader or active_profile_state
    start_target = (
        starter
        or {
            _GENERAL_DEFAULTS["identity"]: start_general,
            _CODE_DEFAULTS["identity"]: start_code,
            _QWEN3_CODER_DEFAULTS["identity"]: start_qwen3_coder,
            _VISION_DEFAULTS["identity"]: start_vision,
        }[target_name]
    )
    read_identity = identity_reader or active_profile_identity

    with lifecycle_lock(lock_path):
        current = read_state()
        if current == "UNKNOWN":
            raise LauncherError("START REFUSED: current LLM state is UNKNOWN; refusing to start")
        if current == target_name:
            print(f"{target_name} ALREADY READY")
            return None
        if current != "STOPPED":
            raise LauncherError(
                f"START REFUSED: active profile is {current}; requested {target_name}"
            )

        try:
            start_target()
        except LauncherError as error:
            raise LauncherError(f"START FAILED: {error}") from error

        if read_state() != target_name:
            raise LauncherError(
                f"START FAILED: target profile {target_name} was not verified READY"
            )

        identity = read_identity()
        if identity is None or identity[0] != target_name or identity[1] <= 0:
            raise LauncherError(
                f"START FAILED: exact {target_name} process identity was not verified"
            )

        print(f"{target_name} STARTED BY THIS INVOCATION")
        print(f"ownership: {target_name} pid={identity[1]}")
        return identity


def stop_active_profiles(
    general_profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    code_profile: CodeProfile = DEFAULT_CODE_PROFILE,
    qwen3_coder_profile: Qwen3CoderProfile = DEFAULT_QWEN3_CODER_PROFILE,
    vision_profile: VisionProfile = DEFAULT_VISION_PROFILE,
    port_reader: Callable[[int], PortState] | None = None,
    general_identity_checker: Callable[[int, GeneralProfile], bool] | None = None,
    code_identity_checker: Callable[[int, CodeProfile], bool] | None = None,
    qwen3_coder_identity_checker: Callable[[int, Qwen3CoderProfile], bool] | None = None,
    vision_identity_checker: Callable[[int, VisionProfile], bool] | None = None,
    killer: Callable[[int, int], Any] | None = None,
    closed_waiter: Callable[[int], bool] | None = None,
    expected_profile: str | None = None,
    expected_pid: int | None = None,
) -> None:
    """Stop one verified supported profile, refusing conflicts or ambiguity."""

    expected_identity = _expected_profile_identity(expected_profile)
    if expected_profile is not None and expected_identity is None:
        raise LauncherError(f"stop refused: unknown expected profile {expected_profile!r}")
    read_port = port_reader or port_state
    states = {port: read_port(port) for port in CONFLICT_PORTS}
    active_ports = [port for port, state in states.items() if state.listening]
    if len(active_ports) > 1 or (
        active_ports
        and active_ports[0]
        not in {
            general_profile.port,
            code_profile.port,
            qwen3_coder_profile.port,
            vision_profile.port,
        }
    ):
        raise LauncherError(
            "stop refused: conflicting or unsupported listener on ports "
            f"{', '.join(map(str, sorted(active_ports)))}"
        )
    if not active_ports:
        if expected_profile is not None or expected_pid is not None:
            raise LauncherError("stop refused: expected profile is no longer active")
        print("LLM STOPPED")
        print("active ports: none")
        return

    port = active_ports[0]
    if port == general_profile.port:
        name = general_profile.identity
        profile: GeneralProfile | CodeProfile | VisionProfile = general_profile
        identity_check = general_identity_checker or is_general_process
    elif port == code_profile.port:
        name = code_profile.identity
        profile = code_profile
        identity_check = code_identity_checker or is_code_process
    elif port == qwen3_coder_profile.port:
        name = qwen3_coder_profile.identity
        profile = qwen3_coder_profile
        identity_check = qwen3_coder_identity_checker or is_qwen3_coder_process
    else:
        name = vision_profile.identity
        profile = vision_profile
        identity_check = vision_identity_checker or is_vision_process
    state = states[port]
    owner_pid = _profile_owner_pid(profile, state)
    if profile.runtime_kind == "podman" and code_identity_checker is not None:
        owner_pid = state.pids[0] if len(state.pids) == 1 else None
    if (expected_profile is not None or expected_pid is not None) and (
        expected_identity != name or owner_pid != expected_pid
    ):
        observed_pid = (
            str(owner_pid)
            if owner_pid is not None
            else ", ".join(map(str, state.pids)) or "unknown"
        )
        raise LauncherError(
            "stop refused: ownership mismatch; expected "
            f"{expected_profile or 'unknown'} PID {expected_pid or 'unknown'}, "
            f"observed {name} PID {observed_pid}"
        )
    _stop_verified_profile(
        name,
        profile,
        state,
        port_reader=read_port,
        identity_checker=identity_check,
        killer=killer,
        closed_waiter=closed_waiter,
    )


def status_general(
    profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    health_check: Callable[[GeneralProfile], bool] | None = None,
) -> None:
    """Report GENERAL port, health, and visible process identity."""

    read_port = port_reader or port_state
    state = read_port(profile.port)
    print(f"port {profile.port}: {'listening' if state.listening else 'closed'}")

    if not state.listening:
        print("health: unavailable")
        print("pid: not running")
        return

    check_health = health_check or _health_ok
    print(f"health: {'OK' if check_health(profile) else 'not OK or unavailable'}")
    if len(state.pids) == 1:
        print(f"pid: {state.pids[0]}")
    elif state.pids:
        print(f"pid: ambiguous ({', '.join(map(str, state.pids))})")
    else:
        print("pid: unknown (ss did not expose the owner)")


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="llm", description=__doc__)
    parser.add_argument(
        "command",
        choices=(
            "code",
            "general",
            "qwen3-coder",
            "vision",
            "project",
            "serve",
            "switch",
            "switch-json",
            "start",
            "stop-owned-json",
            "status",
            "state",
            "identity",
            "stop",
        ),
    )
    parser.add_argument(
        "profile",
        nargs="?",
        choices=(*RUNTIME_RECORDS.keys(), *CLI_PROFILE_ALIASES, *MANIFEST["roles"].keys()),
    )
    parser.add_argument(
        "--role",
        choices=("LOCAL_GENERAL", "LOCAL_CODE", "LOCAL_VISION"),
    )
    parser.add_argument(
        "--profile",
        dest="runtime_profile",
        choices=(*RUNTIME_RECORDS.keys(), *LEGACY_PROFILE_IDENTITIES, *CLI_PROFILE_ALIASES),
    )
    parser.add_argument(
        "--expected-profile",
        choices=(
            *RUNTIME_RECORDS.keys(),
            *LEGACY_PROFILE_IDENTITIES,
            *MANIFEST["roles"].keys(),
            *CLI_PROFILE_ALIASES,
        ),
    )
    parser.add_argument("--expected-pid", type=int)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = _build_parser().parse_args(argv)
    if args.command in {"switch", "switch-json"} and args.profile is None:
        print(f"llm: {args.command} requires a target profile", file=sys.stderr)
        return 2
    if args.command == "start" and args.profile is None:
        print("llm: start requires a target profile", file=sys.stderr)
        return 2
    if args.command == "project" and args.role is None and args.runtime_profile is None:
        print("llm: project requires --role LOCAL_* or --profile PROFILE", file=sys.stderr)
        return 2
    if args.command == "project" and args.role is not None and args.runtime_profile is not None:
        print("llm: project accepts only one of --role or --profile", file=sys.stderr)
        return 2
    if args.command != "project" and args.role is not None:
        print("llm: --role is only valid with project", file=sys.stderr)
        return 2
    if args.command != "project" and args.runtime_profile is not None:
        print("llm: --profile is only valid with project", file=sys.stderr)
        return 2
    if args.command not in {"switch", "switch-json", "start", "serve"} and args.profile is not None:
        print(f"llm: {args.command} does not accept a profile argument", file=sys.stderr)
        return 2
    if (args.expected_profile is None) != (args.expected_pid is None):
        print(
            "llm: --expected-profile and --expected-pid must be supplied together",
            file=sys.stderr,
        )
        return 2
    if args.command not in {"stop", "stop-owned-json"} and (
        args.expected_profile is not None or args.expected_pid is not None
    ):
        print("llm: expected identity options are only valid with stop", file=sys.stderr)
        return 2
    try:
        if args.command == "switch":
            switch_profile(args.profile)
        elif args.command == "switch-json":
            switch_json(args.profile)
        elif args.command == "project":
            projection = (
                project_profile(args.runtime_profile)
                if args.runtime_profile is not None
                else project_role(args.role)
            )
            print(json.dumps(projection, sort_keys=True))
        elif args.command == "stop-owned-json":
            if args.expected_profile is None or args.expected_pid is None:
                print(
                    "llm: stop-owned-json requires --expected-profile and --expected-pid",
                    file=sys.stderr,
                )
                return 2
            stop_owned_json(args.expected_profile, args.expected_pid)
        elif args.command == "start":
            start_profile(args.profile)
        elif args.command == "code":
            with lifecycle_lock():
                start_code()
        elif args.command == "general":
            with lifecycle_lock():
                start_general()
        elif args.command == "qwen3-coder":
            with lifecycle_lock():
                start_qwen3_coder()
        elif args.command == "serve":
            serve_identity = _expected_profile_identity(args.profile or "general")
            if serve_identity == _CODE_DEFAULTS["identity"]:
                serve_code()
            elif serve_identity == _GENERAL_DEFAULTS["identity"]:
                serve_general()
            elif serve_identity == _QWEN3_CODER_DEFAULTS["identity"]:
                serve_qwen3_coder()
            else:
                serve_vision()
        elif args.command == "vision":
            with lifecycle_lock():
                start_vision()
        elif args.command == "status":
            status_profiles()
        elif args.command == "state":
            print(active_profile_state())
        elif args.command == "identity":
            print(machine_profile_identity())
        else:
            with lifecycle_lock():
                stop_active_profiles(
                    expected_profile=args.expected_profile,
                    expected_pid=args.expected_pid,
                )
    except LauncherError as error:
        print(f"llm: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
