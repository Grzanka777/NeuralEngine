#!/usr/bin/env python3
"""Small, explicit launcher for the frozen local LLM profiles."""

from __future__ import annotations

import argparse
import fcntl
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from collections.abc import Callable, Sequence
from contextlib import contextmanager, suppress
from dataclasses import dataclass
from http import HTTPStatus
from pathlib import Path
from typing import Any, cast


def _configured_path(name: str, default: Path) -> Path:
    """Return a path override while preserving the verified host default."""

    value = os.environ.get(name)
    return Path(value).expanduser() if value else default


GENERAL_MODEL = _configured_path(
    "NEURALENGINE_GENERAL_MODEL",
    Path("/models/gguf/qwen3.6-35b-a3b/Qwen3.6-35B-A3B-Q4_K_M.gguf"),
)
GENERAL_MTP = _configured_path(
    "NEURALENGINE_GENERAL_MTP",
    Path("/models/gguf/qwen3.6-35b-a3b/mtp/mtp-Qwen3.6-35B-A3B-Q4_0.gguf"),
)
CODE_MODEL = _configured_path(
    "NEURALENGINE_CODE_MODEL",
    Path("/models/gguf/nemotron-3-nano-30b-a3b/nvidia_Nemotron-3-Nano-30B-A3B-Q5_K_M.gguf"),
)
LLAMA_SERVER = _configured_path(
    "NEURALENGINE_LLAMA_SERVER",
    Path("/home/grzanka/Work/LLM/strix-llama.cpp/build-vulkan/bin/llama-server"),
)
GENERAL_HOST = "127.0.0.1"
GENERAL_PORT = 18081
CODE_HOST = "127.0.0.1"
CODE_PORT = 18080
UNFILLED_ROLES = {"VISION"}
CONFLICT_PORTS = (18080, 18081, 18082, 18086, 18087)
HEALTH_TIMEOUT_SECONDS = 300
HEALTH_POLL_SECONDS = 1
HEALTH_REQUEST_TIMEOUT_SECONDS = 2
STOP_TIMEOUT_SECONDS = 90
STOP_POLL_SECONDS = 1
LIFECYCLE_LOCK_FILENAME = "lifecycle.lock"
_PID_PATTERN = re.compile(r"\bpid=(\d+)\b")


class LauncherError(RuntimeError):
    """A safe, user-facing launcher failure."""


@dataclass(frozen=True, slots=True)
class GeneralProfile:
    """The immutable production GENERAL profile."""

    model: Path = GENERAL_MODEL
    mtp: Path = GENERAL_MTP
    runtime: Path = LLAMA_SERVER
    host: str = GENERAL_HOST
    port: int = GENERAL_PORT

    def arguments(self) -> tuple[str, ...]:
        """Return the frozen llama-server arguments after the executable."""

        return (
            "-m",
            str(self.model),
            "-dev",
            "Vulkan0",
            "-ngl",
            "999",
            "-c",
            "65536",
            "-b",
            "2048",
            "-ub",
            "1024",
            "-np",
            "1",
            "-fa",
            "on",
            "--cache-prompt",
            "--spec-type",
            "draft-mtp",
            "--spec-draft-model",
            str(self.mtp),
            "--spec-draft-device",
            "Vulkan0",
            "--spec-draft-ngl",
            "999",
            "--spec-draft-n-max",
            "3",
            "--metrics",
            "--host",
            self.host,
            "--port",
            str(self.port),
        )

    def command(self) -> tuple[str, ...]:
        """Return the complete frozen command line."""

        return (str(self.runtime), *self.arguments())

    def endpoint(self) -> str:
        """Return the OpenAI-compatible endpoint."""

        return f"http://{self.host}:{self.port}/v1"


DEFAULT_PROFILE = GeneralProfile()


@dataclass(frozen=True, slots=True)
class CodeProfile:
    """The verified Nemotron Q5 CODE profile."""

    model: Path = CODE_MODEL
    runtime: Path = LLAMA_SERVER
    host: str = CODE_HOST
    port: int = CODE_PORT

    def arguments(self) -> tuple[str, ...]:
        return (
            "-m",
            str(self.model),
            "-dev",
            "Vulkan0",
            "-ngl",
            "999",
            "-c",
            "32768",
            "-b",
            "2048",
            "-ub",
            "512",
            "-fa",
            "auto",
            "--jinja",
            "--parallel",
            "1",
            "-lv",
            "4",
            "--host",
            self.host,
            "--port",
            str(self.port),
        )

    def command(self) -> tuple[str, ...]:
        return (str(self.runtime), *self.arguments())

    def endpoint(self) -> str:
        return f"http://{self.host}:{self.port}/v1"


DEFAULT_CODE_PROFILE = CodeProfile()


@dataclass(frozen=True, slots=True)
class PortState:
    """Listening state and visible owning PIDs for one TCP port."""

    listening: bool
    pids: tuple[int, ...] = ()


def _local_port(address: str) -> int | None:
    if address.startswith("["):
        _, separator, port = address.rpartition("]:")
    else:
        _, separator, port = address.rpartition(":")
    if not separator:
        return None
    try:
        return int(port)
    except ValueError:
        return None


def _port_state_from_ss_output(output: str, port: int) -> PortState:
    pids: set[int] = set()
    listening = False

    for line in output.splitlines():
        fields = line.split()
        if len(fields) < 4 or fields[0] != "LISTEN":
            continue
        if _local_port(fields[3]) != port:
            continue

        listening = True
        pids.update(int(match) for match in _PID_PATTERN.findall(line))

    return PortState(listening=listening, pids=tuple(sorted(pids)))


def port_state(port: int) -> PortState:
    """Read one TCP listening port using Linux's standard ``ss`` utility."""

    try:
        result = subprocess.run(
            ["ss", "-H", "-ltnp"],
            capture_output=True,
            check=False,
            text=True,
        )
    except OSError as error:
        raise LauncherError(f"Cannot inspect TCP listeners with ss: {error}") from error

    if result.returncode != 0:
        detail = result.stderr.strip() or "ss returned a non-zero status"
        raise LauncherError(f"Cannot inspect TCP listeners: {detail}")

    return _port_state_from_ss_output(result.stdout, port)


def _process_command_line(pid: int) -> tuple[str, ...] | None:
    try:
        raw_command_line = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return None

    return tuple(
        item.decode("utf-8", errors="replace") for item in raw_command_line.split(b"\0") if item
    )


def is_general_process(pid: int, profile: GeneralProfile = DEFAULT_PROFILE) -> bool:
    """Verify the complete command line before allowing a stop."""

    return _process_command_line(pid) == profile.command()


def is_code_process(pid: int, profile: CodeProfile = DEFAULT_CODE_PROFILE) -> bool:
    """Verify the complete CODE command line before allowing a stop."""

    return _process_command_line(pid) == profile.command()


def _health_ok(profile: GeneralProfile | CodeProfile) -> bool:
    request = urllib.request.Request(
        f"http://{profile.host}:{profile.port}/health",
        method="GET",
    )
    try:
        with urllib.request.urlopen(  # noqa: S310 - localhost-only health check
            request,
            timeout=HEALTH_REQUEST_TIMEOUT_SECONDS,
        ) as response:
            return cast(int, response.status) == HTTPStatus.OK
    except OSError, TimeoutError, urllib.error.URLError:
        return False


def wait_for_health(
    profile: GeneralProfile | CodeProfile = DEFAULT_PROFILE,
    *,
    timeout_seconds: float = HEALTH_TIMEOUT_SECONDS,
    poll_seconds: float = HEALTH_POLL_SECONDS,
    health_check: Callable[[], bool] | None = None,
    clock: Callable[[], float] = time.monotonic,
    sleeper: Callable[[float], Any] = time.sleep,
) -> bool:
    """Wait until ``/health`` returns HTTP 200 or the timeout expires."""

    check = health_check or (lambda: _health_ok(profile))
    deadline = clock() + timeout_seconds

    while True:
        if check():
            return True
        if clock() >= deadline:
            return False
        sleeper(poll_seconds)


def _state_log_path() -> Path:
    state_home = os.environ.get("XDG_STATE_HOME")
    root = Path(state_home) if state_home else Path.home() / ".local" / "state"
    return root / "llm" / "general.log"


def _code_log_path() -> Path:
    state_home = os.environ.get("XDG_STATE_HOME")
    root = Path(state_home) if state_home else Path.home() / ".local" / "state"
    return root / "llm" / "code.log"


def _lifecycle_lock_path() -> Path:
    state_home = os.environ.get("XDG_STATE_HOME")
    root = Path(state_home) if state_home else Path.home() / ".local" / "state"
    # This lock is shared with every local model launcher, including the
    # PATCH challenger.  Per-launcher locks cannot serialize cross-entrypoint
    # startup races.
    return root / "neuralengine" / LIFECYCLE_LOCK_FILENAME


@contextmanager
def lifecycle_lock(lock_path: Path | None = None) -> Any:
    """Serialize all production LLM lifecycle transitions with ``flock``."""

    selected_path = lock_path or _lifecycle_lock_path()
    try:
        selected_path.parent.mkdir(parents=True, exist_ok=True)
        with selected_path.open("a+") as lock_file:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
            try:
                yield
            finally:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
    except OSError as error:
        raise LauncherError(
            f"Cannot acquire LLM lifecycle lock {selected_path}: {error}"
        ) from error


def _terminate_started_process(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return
    process.terminate()
    with suppress(subprocess.TimeoutExpired):
        process.wait(timeout=5)


def _serve_foreground(
    profile: GeneralProfile | CodeProfile,
    *,
    action: str,
    validate: Callable[[], None],
    port_reader: Callable[[int], PortState],
    process_replacer: Callable[[str, Sequence[str]], Any] | None,
    process_factory: Callable[..., subprocess.Popen[Any]] | None,
    health_waiter: Callable[[GeneralProfile | CodeProfile], bool] | None,
    process_waiter: Callable[[subprocess.Popen[Any]], int | None] | None,
) -> None:
    """Run a foreground server after the shared startup lock reaches readiness.

    ``serve`` cannot ``exec`` directly while holding the lock: Python closes
    the lock descriptor during exec and the lock would not cover the bind
    window.  A small parent process instead holds the lock through health
    readiness, releases it, and waits for the server child for systemd.
    ``process_replacer`` remains a test seam for the historical exact-command
    assertions.
    """

    validate()

    def refuse_conflicts() -> None:
        conflicts = [port for port in CONFLICT_PORTS if port_reader(port).listening]
        if conflicts:
            raise LauncherError(
                f"{action} serve refused: a listener already occupies port(s): "
                + ", ".join(map(str, conflicts))
            )

    if process_replacer is not None:
        refuse_conflicts()
        try:
            process_replacer(str(profile.runtime), profile.command())
        except OSError as error:
            raise LauncherError(f"{action} serve failed to exec llama-server: {error}") from error
        return

    create_process = process_factory or subprocess.Popen
    wait_health = health_waiter or (lambda selected_profile: wait_for_health(selected_profile))
    with lifecycle_lock():
        refuse_conflicts()
        try:
            process = create_process(
                profile.command(),
                stdin=subprocess.DEVNULL,
                close_fds=True,
            )
        except OSError as error:
            raise LauncherError(f"{action} serve failed to launch llama-server: {error}") from error
        if not wait_health(profile):
            _terminate_started_process(process)
            raise LauncherError(
                f"{action} serve failed: /health did not become OK within "
                f"{HEALTH_TIMEOUT_SECONDS} seconds"
            )

    wait_process = process_waiter or (lambda selected_process: selected_process.wait())
    try:
        return_code = wait_process(process)
    except KeyboardInterrupt:
        _terminate_started_process(process)
        raise
    if return_code not in (None, 0):
        raise LauncherError(f"{action} serve exited with status {return_code}")


def detect_verified_running_profile(
    state: PortState,
    *,
    identity_checker: Callable[[int], bool],
    health_check: Callable[[], bool],
) -> int | None:
    """Return the verified PID when exactly one known-good process owns the port, else None.

    Returns the PID only when ALL three conditions hold:
    - exactly one visible PID owns the port,
    - the process command line matches the expected profile, and
    - the health endpoint reports healthy.

    Returns None for any deviation: unknown PID, multiple PIDs, cmdline mismatch,
    or unhealthy endpoint.  Callers must treat None as a refusal condition.
    """

    if len(state.pids) != 1:
        return None
    pid = state.pids[0]
    if not identity_checker(pid):
        return None
    if not health_check():
        return None
    return pid


def _validate_general_prerequisites(profile: GeneralProfile, action: str) -> None:
    for label, path in (
        ("model", profile.model),
        ("MTP model", profile.mtp),
        ("llama-server runtime", profile.runtime),
    ):
        if not path.is_file():
            raise LauncherError(f"GENERAL {action} refused: {label} does not exist: {path}")
    if not os.access(profile.runtime, os.X_OK):
        raise LauncherError(
            f"GENERAL {action} refused: runtime is not executable: {profile.runtime}"
        )


def start_general(
    profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    process_factory: Callable[..., subprocess.Popen[bytes]] | None = None,
    health_waiter: Callable[[GeneralProfile], bool] | None = None,
    log_path: Callable[[], Path] | None = None,
    identity_checker: Callable[[int, GeneralProfile], bool] | None = None,
    health_check: Callable[[GeneralProfile], bool] | None = None,
) -> None:
    """Validate, launch, and health-check the frozen GENERAL profile.

    Idempotent: if the exact verified GENERAL profile is already running and healthy,
    prints GENERAL ALREADY READY and returns without spawning a new process.
    """

    _validate_general_prerequisites(profile, "start")

    read_port = port_reader or port_state
    check_identity = identity_checker or is_general_process
    check_health = health_check or _health_ok

    # Idempotency: if the profile's own port is already occupied, check whether
    # it is the exact verified, healthy profile before running the full conflict scan.
    own_state = read_port(profile.port)
    if own_state.listening:
        verified_pid = detect_verified_running_profile(
            own_state,
            identity_checker=lambda pid: check_identity(pid, profile),
            health_check=lambda: check_health(profile),
        )
        if verified_pid is not None:
            print("GENERAL ALREADY READY")
            print(f"endpoint: {profile.endpoint()}")
            print(f"pid: {verified_pid}")
            return

    conflicts = [port for port in CONFLICT_PORTS if read_port(port).listening]
    if conflicts:
        formatted_ports = ", ".join(str(port) for port in conflicts)
        raise LauncherError(
            f"GENERAL start refused: a listener already occupies port(s): {formatted_ports}"
        )

    create_process = process_factory or subprocess.Popen
    target_log_path = log_path or _state_log_path
    log_file_path = target_log_path()
    try:
        log_file_path.parent.mkdir(parents=True, exist_ok=True)
        with log_file_path.open("ab") as log_file:
            process = create_process(
                profile.command(),
                stdin=subprocess.DEVNULL,
                stdout=log_file,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                close_fds=True,
            )
    except OSError as error:
        raise LauncherError(f"GENERAL start failed to launch llama-server: {error}") from error

    wait_health = health_waiter or (lambda selected_profile: wait_for_health(selected_profile))
    if not wait_health(profile):
        _terminate_started_process(process)
        raise LauncherError(
            "GENERAL start failed: /health did not become OK within "
            f"{HEALTH_TIMEOUT_SECONDS} seconds"
        )

    print("GENERAL READY")
    print(f"endpoint: {profile.endpoint()}")
    print(f"pid: {process.pid}")


def serve_general(
    profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    process_replacer: Callable[[str, Sequence[str]], Any] | None = None,
    process_factory: Callable[..., subprocess.Popen[Any]] | None = None,
    health_waiter: Callable[[GeneralProfile], bool] | None = None,
    process_waiter: Callable[[subprocess.Popen[Any]], int | None] | None = None,
) -> None:
    """Run the verified GENERAL profile in the foreground for systemd."""

    _serve_foreground(
        profile,
        action="GENERAL",
        validate=lambda: _validate_general_prerequisites(profile, "serve"),
        port_reader=port_reader or port_state,
        process_replacer=process_replacer,
        process_factory=process_factory,
        health_waiter=health_waiter,
        process_waiter=process_waiter,
    )


def _validate_code_prerequisites(profile: CodeProfile, action: str) -> None:
    for label, path in (("model", profile.model), ("llama-server runtime", profile.runtime)):
        if not path.is_file():
            raise LauncherError(f"CODE {action} refused: {label} does not exist: {path}")
    if not os.access(profile.runtime, os.X_OK):
        raise LauncherError(f"CODE {action} refused: runtime is not executable: {profile.runtime}")


def start_code(
    profile: CodeProfile = DEFAULT_CODE_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    process_factory: Callable[..., subprocess.Popen[bytes]] | None = None,
    health_waiter: Callable[[CodeProfile], bool] | None = None,
    log_path: Callable[[], Path] | None = None,
    identity_checker: Callable[[int, CodeProfile], bool] | None = None,
    health_check: Callable[[CodeProfile], bool] | None = None,
) -> None:
    """Launch CODE only when no other local profile owns a conflict port."""

    _validate_code_prerequisites(profile, "start")
    read_port = port_reader or port_state
    check_identity = identity_checker or is_code_process
    check_health = health_check or _health_ok
    own_state = read_port(profile.port)
    if own_state.listening:
        verified_pid = detect_verified_running_profile(
            own_state,
            identity_checker=lambda pid: check_identity(pid, profile),
            health_check=lambda: check_health(profile),
        )
        if verified_pid is not None:
            print("CODE ALREADY READY")
            print(f"endpoint: {profile.endpoint()}")
            print(f"pid: {verified_pid}")
            return

    conflicts = [port for port in CONFLICT_PORTS if read_port(port).listening]
    if conflicts:
        raise LauncherError(
            "CODE start refused: a listener already occupies port(s): "
            + ", ".join(map(str, conflicts))
        )

    create_process = process_factory or subprocess.Popen
    target_log_path = log_path or _code_log_path
    log_file_path = target_log_path()
    try:
        log_file_path.parent.mkdir(parents=True, exist_ok=True)
        with log_file_path.open("ab") as log_file:
            process = create_process(
                profile.command(),
                stdin=subprocess.DEVNULL,
                stdout=log_file,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                close_fds=True,
            )
    except OSError as error:
        raise LauncherError(f"CODE start failed to launch llama-server: {error}") from error

    wait_health = health_waiter or (lambda selected_profile: wait_for_health(selected_profile))
    if not wait_health(profile):
        _terminate_started_process(process)
        raise LauncherError(
            f"CODE start failed: /health did not become OK within {HEALTH_TIMEOUT_SECONDS} seconds"
        )

    print("CODE READY")
    print(f"endpoint: {profile.endpoint()}")
    print(f"pid: {process.pid}")


def serve_code(
    profile: CodeProfile = DEFAULT_CODE_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    process_replacer: Callable[[str, Sequence[str]], Any] | None = None,
    process_factory: Callable[..., subprocess.Popen[Any]] | None = None,
    health_waiter: Callable[[CodeProfile], bool] | None = None,
    process_waiter: Callable[[subprocess.Popen[Any]], int | None] | None = None,
) -> None:
    """Run CODE in the foreground for an explicitly started systemd unit."""

    _serve_foreground(
        profile,
        action="CODE",
        validate=lambda: _validate_code_prerequisites(profile, "serve"),
        port_reader=port_reader or port_state,
        process_replacer=process_replacer,
        process_factory=process_factory,
        health_waiter=health_waiter,
        process_waiter=process_waiter,
    )


def wait_for_port_closed(
    port: int,
    *,
    port_reader: Callable[[int], PortState] = port_state,
    timeout_seconds: float = STOP_TIMEOUT_SECONDS,
    poll_seconds: float = STOP_POLL_SECONDS,
    clock: Callable[[], float] = time.monotonic,
    sleeper: Callable[[float], Any] = time.sleep,
) -> bool:
    """Wait until a TCP port no longer has a listener."""

    deadline = clock() + timeout_seconds
    while True:
        if not port_reader(port).listening:
            return True
        if clock() >= deadline:
            return False
        sleeper(poll_seconds)


def stop_general(
    profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    identity_checker: Callable[[int, GeneralProfile], bool] | None = None,
    killer: Callable[[int, int], Any] | None = None,
    closed_waiter: Callable[[int], bool] | None = None,
) -> None:
    """Stop only the verified GENERAL process that owns port 18081."""

    read_port = port_reader or port_state
    state = read_port(profile.port)
    if not state.listening:
        print("GENERAL STOPPED")
        print(f"port {profile.port}: closed")
        return

    if len(state.pids) != 1:
        raise LauncherError(
            f"GENERAL stop refused: owner of port {profile.port} is ambiguous "
            f"(visible PIDs: {', '.join(map(str, state.pids)) or 'unknown'})"
        )

    pid = state.pids[0]
    check_identity = identity_checker or is_general_process
    if not check_identity(pid, profile):
        raise LauncherError(f"GENERAL stop refused: PID {pid} is not the verified GENERAL profile")

    send_signal = killer or os.kill
    try:
        send_signal(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except OSError as error:
        raise LauncherError(f"GENERAL stop failed for verified PID {pid}: {error}") from error

    wait_closed = closed_waiter or (
        lambda selected_port: wait_for_port_closed(selected_port, port_reader=read_port)
    )
    if not wait_closed(profile.port):
        raise LauncherError(f"GENERAL stop failed: port {profile.port} is still listening")

    print("GENERAL STOPPED")
    print(f"port {profile.port}: closed")


def _stop_verified_profile(
    profile_name: str,
    profile: Any,
    state: PortState,
    *,
    port_reader: Callable[[int], PortState],
    identity_checker: Callable[[int, Any], bool],
    killer: Callable[[int, int], Any] | None = None,
    closed_waiter: Callable[[int], bool] | None = None,
) -> None:
    if len(state.pids) != 1:
        raise LauncherError(
            f"{profile_name} stop refused: owner of port {profile.port} is ambiguous "
            f"(visible PIDs: {', '.join(map(str, state.pids)) or 'unknown'})"
        )

    pid = state.pids[0]
    if not identity_checker(pid, profile):
        raise LauncherError(
            f"{profile_name} stop refused: PID {pid} is not the verified {profile_name} profile"
        )

    send_signal = killer or os.kill
    try:
        send_signal(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except OSError as error:
        raise LauncherError(
            f"{profile_name} stop failed for verified PID {pid}: {error}"
        ) from error

    wait_closed = closed_waiter or (
        lambda selected_port: wait_for_port_closed(selected_port, port_reader=port_reader)
    )
    if not wait_closed(profile.port):
        raise LauncherError(f"{profile_name} stop failed: port {profile.port} is still listening")

    print(f"{profile_name} STOPPED")
    print(f"port {profile.port}: closed")


def _print_status_pid(state: PortState) -> None:
    if len(state.pids) == 1:
        print(f"pid: {state.pids[0]}")
    elif state.pids:
        print(f"pid: ambiguous ({', '.join(map(str, state.pids))})")
    else:
        print("pid: unknown (ss did not expose the owner)")


def status_profiles(
    general_profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    code_profile: CodeProfile = DEFAULT_CODE_PROFILE,
    port_reader: Callable[[int], PortState] | None = None,
    general_health_check: Callable[[GeneralProfile], bool] | None = None,
    general_identity_checker: Callable[[int, GeneralProfile], bool] | None = None,
    code_health_check: Callable[[CodeProfile], bool] | None = None,
    code_identity_checker: Callable[[int, CodeProfile], bool] | None = None,
) -> None:
    """Report supported profile state without changing any process state."""

    read_port = port_reader or port_state
    states = {port: read_port(port) for port in CONFLICT_PORTS}
    active_ports = [port for port, state in states.items() if state.listening]
    if not active_ports:
        print("LLM STOPPED")
        print("VISION: UNFILLED/disabled")
        print("profile: none")
        print("active port: none")
        print("health: unavailable")
        print("pid: not running")
        return

    if len(active_ports) != 1:
        print("profile: CONFLICT")
        print(f"active ports: {', '.join(map(str, sorted(active_ports)))}")
        print("VISION: UNFILLED/disabled")
        return

    port = active_ports[0]
    if port == general_profile.port:
        name: str = "GENERAL"
        profile: GeneralProfile | CodeProfile = general_profile
        identity_check = general_identity_checker or is_general_process
        health_check = general_health_check or _health_ok
    elif port == code_profile.port:
        name = "CODE"
        profile = code_profile
        identity_check = code_identity_checker or is_code_process
        health_check = code_health_check or _health_ok
    else:
        print("profile: UNKNOWN")
        print(f"active port: {port}")
        print("VISION: UNFILLED/disabled")
        _print_status_pid(states[port])
        return

    state = states[port]
    identifiable = len(state.pids) == 1 and identity_check(state.pids[0], profile)
    print(f"profile: {name if identifiable else 'unknown'}")
    print(f"active port: {profile.port}")
    print(f"port {profile.port}: listening")
    print(f"health: {'OK' if health_check(profile) else 'not OK or unavailable'}")
    print("VISION: UNFILLED/disabled")
    _print_status_pid(state)


def active_profile_state(
    general_profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    code_profile: CodeProfile = DEFAULT_CODE_PROFILE,
    port_reader: Callable[[int], PortState] | None = None,
    general_health_check: Callable[[GeneralProfile], bool] | None = None,
    general_identity_checker: Callable[[int, GeneralProfile], bool] | None = None,
    code_health_check: Callable[[CodeProfile], bool] | None = None,
    code_identity_checker: Callable[[int, CodeProfile], bool] | None = None,
) -> str:
    """Return one exact, machine-readable verified production state.

    ``UNKNOWN`` is returned for every state that cannot be proven to be one
    healthy, uniquely owned frozen profile.  The wrapper uses this as a
    fail-closed ownership boundary.
    """

    read_port = port_reader or port_state
    if not any(read_port(port).listening for port in CONFLICT_PORTS):
        return "STOPPED"
    identity = active_profile_identity(
        general_profile,
        code_profile=code_profile,
        port_reader=read_port,
        general_health_check=general_health_check,
        general_identity_checker=general_identity_checker,
        code_health_check=code_health_check,
        code_identity_checker=code_identity_checker,
    )
    return identity[0] if identity is not None else "UNKNOWN"


def active_profile_identity(
    general_profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    code_profile: CodeProfile = DEFAULT_CODE_PROFILE,
    port_reader: Callable[[int], PortState] | None = None,
    general_health_check: Callable[[GeneralProfile], bool] | None = None,
    general_identity_checker: Callable[[int, GeneralProfile], bool] | None = None,
    code_health_check: Callable[[CodeProfile], bool] | None = None,
    code_identity_checker: Callable[[int, CodeProfile], bool] | None = None,
) -> tuple[str, int] | None:
    """Return the exact verified active profile and PID, or ``None``."""

    read_port = port_reader or port_state
    states = {port: read_port(port) for port in CONFLICT_PORTS}
    active_ports = [port for port, state in states.items() if state.listening]
    if len(active_ports) != 1:
        return None
    port = active_ports[0]
    if port == general_profile.port:
        name = "GENERAL"
        profile: GeneralProfile | CodeProfile = general_profile
        identity_check = general_identity_checker or is_general_process
        health_check = general_health_check or _health_ok
    elif port == code_profile.port:
        name = "CODE"
        profile = code_profile
        identity_check = code_identity_checker or is_code_process
        health_check = code_health_check or _health_ok
    else:
        return None
    verified_pid = detect_verified_running_profile(
        states[port],
        identity_checker=lambda pid: identity_check(pid, profile),
        health_check=lambda: health_check(profile),
    )
    if verified_pid is None:
        return None
    return name, verified_pid


def machine_profile_identity() -> str:
    """Return ``PROFILE PID``, ``STOPPED``, or ``UNKNOWN`` for automation."""

    state = active_profile_state()
    if state == "STOPPED":
        return "STOPPED"
    identity = active_profile_identity()
    if identity is None:
        return "UNKNOWN"
    profile_name, pid = identity
    return f"{profile_name} {pid}"


def switch_profile(
    target: str,
    *,
    state_reader: Callable[[], str] | None = None,
    stopper: Callable[[], None] | None = None,
    starter: Callable[[], None] | None = None,
    lock_path: Path | None = None,
) -> None:
    """Switch between verified production profiles while holding the lifecycle lock."""

    target_name = target.upper()
    if target_name in UNFILLED_ROLES:
        raise LauncherError("SWITCH FAILED: VISION is UNFILLED/disabled; no model is assigned")
    if target_name not in {"GENERAL", "CODE"}:
        raise LauncherError(f"SWITCH FAILED: unsupported target profile: {target}")

    read_state = state_reader or active_profile_state
    stop_current = stopper or stop_active_profiles
    start_target = starter or (start_general if target_name == "GENERAL" else start_code)

    with lifecycle_lock(lock_path):
        current = read_state()
        if current == "UNKNOWN":
            raise LauncherError(
                "SWITCH FAILED: current LLM state is UNKNOWN; refusing to stop or start"
            )
        if current == target_name:
            print(f"{target_name} ALREADY READY")
            return
        if current not in {"STOPPED", "GENERAL", "CODE"}:
            raise LauncherError(f"SWITCH FAILED: unsupported current LLM state: {current}")

        try:
            if current != "STOPPED":
                stop_current()
                if read_state() != "STOPPED":
                    raise LauncherError(
                        f"old profile {current} did not reach verified STOPPED state"
                    )

            start_target()
            if read_state() != target_name:
                raise LauncherError(f"target profile {target_name} was not verified READY")
        except LauncherError as error:
            message = str(error)
            if message.startswith("SWITCH FAILED:"):
                raise
            raise LauncherError(f"SWITCH FAILED: {message}") from error


def start_profile(
    target: str,
    *,
    state_reader: Callable[[], str] | None = None,
    starter: Callable[[], None] | None = None,
    identity_reader: Callable[[], tuple[str, int] | None] | None = None,
    lock_path: Path | None = None,
) -> tuple[str, int] | None:
    """Start only from STOPPED; return identity only when this call started it."""

    target_name = target.upper()
    if target_name in UNFILLED_ROLES:
        raise LauncherError("START REFUSED: VISION is UNFILLED/disabled; no model is assigned")
    if target_name not in {"GENERAL", "CODE"}:
        raise LauncherError(f"START REFUSED: unsupported target profile: {target}")

    read_state = state_reader or active_profile_state
    start_target = starter or (start_general if target_name == "GENERAL" else start_code)
    read_identity = identity_reader or active_profile_identity

    with lifecycle_lock(lock_path):
        current = read_state()
        if current == "UNKNOWN":
            raise LauncherError("START REFUSED: current LLM state is UNKNOWN; refusing to start")
        if current == target_name:
            print(f"{target_name} ALREADY READY")
            return None
        if current != "STOPPED":
            raise LauncherError(
                f"START REFUSED: active profile is {current}; requested {target_name}"
            )

        try:
            start_target()
        except LauncherError as error:
            raise LauncherError(f"START FAILED: {error}") from error

        if read_state() != target_name:
            raise LauncherError(
                f"START FAILED: target profile {target_name} was not verified READY"
            )

        identity = read_identity()
        if identity is None or identity[0] != target_name or identity[1] <= 0:
            raise LauncherError(
                f"START FAILED: exact {target_name} process identity was not verified"
            )

        print(f"{target_name} STARTED BY THIS INVOCATION")
        print(f"ownership: {target_name} pid={identity[1]}")
        return identity


def stop_active_profiles(
    general_profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    code_profile: CodeProfile = DEFAULT_CODE_PROFILE,
    port_reader: Callable[[int], PortState] | None = None,
    general_identity_checker: Callable[[int, GeneralProfile], bool] | None = None,
    code_identity_checker: Callable[[int, CodeProfile], bool] | None = None,
    killer: Callable[[int, int], Any] | None = None,
    closed_waiter: Callable[[int], bool] | None = None,
    expected_profile: str | None = None,
    expected_pid: int | None = None,
) -> None:
    """Stop one verified supported profile, refusing conflicts or ambiguity."""

    read_port = port_reader or port_state
    states = {port: read_port(port) for port in CONFLICT_PORTS}
    active_ports = [port for port, state in states.items() if state.listening]
    if len(active_ports) > 1 or (
        active_ports and active_ports[0] not in {general_profile.port, code_profile.port}
    ):
        raise LauncherError(
            "stop refused: conflicting or unsupported listener on ports "
            f"{', '.join(map(str, sorted(active_ports)))}"
        )
    if not active_ports:
        if expected_profile is not None or expected_pid is not None:
            raise LauncherError("stop refused: expected profile is no longer active")
        print("LLM STOPPED")
        print("active ports: none")
        return

    port = active_ports[0]
    if port == general_profile.port:
        name = "GENERAL"
        profile: GeneralProfile | CodeProfile = general_profile
        identity_check = general_identity_checker or is_general_process
    else:
        name = "CODE"
        profile = code_profile
        identity_check = code_identity_checker or is_code_process
    state = states[port]
    if (expected_profile is not None or expected_pid is not None) and (
        expected_profile != name or len(state.pids) != 1 or state.pids[0] != expected_pid
    ):
        observed_pid = ", ".join(map(str, state.pids)) or "unknown"
        raise LauncherError(
            "stop refused: ownership mismatch; expected "
            f"{expected_profile or 'unknown'} PID {expected_pid or 'unknown'}, "
            f"observed {name} PID {observed_pid}"
        )
    _stop_verified_profile(
        name,
        profile,
        state,
        port_reader=read_port,
        identity_checker=identity_check,
        killer=killer,
        closed_waiter=closed_waiter,
    )


def status_general(
    profile: GeneralProfile = DEFAULT_PROFILE,
    *,
    port_reader: Callable[[int], PortState] | None = None,
    health_check: Callable[[GeneralProfile], bool] | None = None,
) -> None:
    """Report GENERAL port, health, and visible process identity."""

    read_port = port_reader or port_state
    state = read_port(profile.port)
    print(f"port {profile.port}: {'listening' if state.listening else 'closed'}")

    if not state.listening:
        print("health: unavailable")
        print("pid: not running")
        return

    check_health = health_check or _health_ok
    print(f"health: {'OK' if check_health(profile) else 'not OK or unavailable'}")
    if len(state.pids) == 1:
        print(f"pid: {state.pids[0]}")
    elif state.pids:
        print(f"pid: ambiguous ({', '.join(map(str, state.pids))})")
    else:
        print("pid: unknown (ss did not expose the owner)")


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="llm", description=__doc__)
    parser.add_argument(
        "command",
        choices=(
            "code",
            "general",
            "vision",
            "serve",
            "switch",
            "start",
            "status",
            "state",
            "identity",
            "stop",
        ),
    )
    parser.add_argument("profile", nargs="?", choices=("code", "general", "vision"))
    parser.add_argument("--expected-profile", choices=("GENERAL", "CODE"))
    parser.add_argument("--expected-pid", type=int)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = _build_parser().parse_args(argv)
    if args.command == "switch" and args.profile is None:
        print("llm: switch requires a target profile", file=sys.stderr)
        return 2
    if args.command == "start" and args.profile is None:
        print("llm: start requires a target profile", file=sys.stderr)
        return 2
    if args.command not in {"switch", "start", "serve"} and args.profile is not None:
        print(f"llm: {args.command} does not accept a profile argument", file=sys.stderr)
        return 2
    if (args.expected_profile is None) != (args.expected_pid is None):
        print(
            "llm: --expected-profile and --expected-pid must be supplied together",
            file=sys.stderr,
        )
        return 2
    if args.command != "stop" and (
        args.expected_profile is not None or args.expected_pid is not None
    ):
        print("llm: expected identity options are only valid with stop", file=sys.stderr)
        return 2
    try:
        if args.command == "switch":
            switch_profile(args.profile)
        elif args.command == "start":
            start_profile(args.profile)
        elif args.command == "code":
            with lifecycle_lock():
                start_code()
        elif args.command == "general":
            with lifecycle_lock():
                start_general()
        elif args.command == "serve":
            if args.profile == "code":
                serve_code()
            elif args.profile in {None, "general"}:
                serve_general()
            else:
                raise LauncherError("VISION is UNFILLED/disabled; no model is assigned")
        elif args.command == "vision":
            raise LauncherError("VISION is UNFILLED/disabled; no model is assigned")
        elif args.command == "status":
            status_profiles()
        elif args.command == "state":
            print(active_profile_state())
        elif args.command == "identity":
            print(machine_profile_identity())
        else:
            with lifecycle_lock():
                stop_active_profiles(
                    expected_profile=args.expected_profile,
                    expected_pid=args.expected_pid,
                )
    except LauncherError as error:
        print(f"llm: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
