#!/usr/bin/env python3
"""Read-only drift check for the local production LLM manifest."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
from typing import Any

REPO = Path(__file__).resolve().parent.parent


def _load_json(path: Path) -> dict[str, Any]:
    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError(f"{path}: expected a JSON object")
    return value


def _load_script(path: Path, name: str) -> Any:
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"cannot load {path}")
    module = module_from_spec(spec)
    sys.modules[spec.name] = module
    loader.exec_module(module)
    return module


def _flag_value(args: tuple[str, ...], flag: str) -> str | None:
    return args[args.index(flag) + 1] if flag in args else None


def _expect_single_flag(
    errors: list[str],
    args: tuple[str, ...],
    *,
    label: str,
    flag: str,
    expected: str,
) -> None:
    """Require one unambiguous option/value pair in an active command."""

    values = [
        args[index + 1] if index + 1 < len(args) else None
        for index, value in enumerate(args)
        if value == flag
    ]
    if len(values) != 1:
        errors.append(f"{label}: expected exactly one {flag} value, got {values!r}")
    elif values[0] != expected:
        errors.append(f"{label}: expected {expected!r}, got {values[0]!r}")


def _expect_single_toggle(
    errors: list[str],
    args: tuple[str, ...],
    *,
    label: str,
    enabled: str,
    disabled: str,
) -> None:
    """Require one enabled toggle and reject its contradictory form."""

    count = args.count(enabled)
    if count != 1:
        errors.append(f"{label}: expected exactly one toggle, got {count}")
    if disabled in args:
        errors.append(f"{label}: contradictory {disabled} toggle is active")


def _check_artifact(
    errors: list[str], label: str, path: Path, digest: str | None, check_hashes: bool
) -> None:
    if not path.is_file():
        errors.append(f"{label} missing: {path}")
    elif check_hashes:
        if digest is None:
            errors.append(f"{label}: SHA256 not recorded")
        else:
            with path.open("rb") as handle:
                if hashlib.file_digest(handle, "sha256").hexdigest() != digest:
                    errors.append(f"{label}: SHA256 mismatch")


def _validate_client_settings(
    errors: list[str],
    roles: dict[str, Any],
    pi_catalog: dict[str, Any],
    pi_settings: tuple[dict[str, Any], ...],
    qwen_settings: tuple[dict[str, Any], ...],
) -> None:
    """Check routing only; never report credential-bearing configuration objects."""
    providers = pi_catalog.get("providers", {})
    if set(providers) - {"deepseek"}:
        errors.append("Pi contains non-DeepSeek provider entries")
    for provider in providers.values():
        if any(model.get("id") != "deepseek-flash" for model in provider.get("models", [])):
            errors.append("Pi contains a non-flash model entry")
    for settings in pi_settings:
        if settings.get("defaultProvider") != "deepseek":
            errors.append("Pi default provider drift")
        if settings.get("defaultModel") != "deepseek-flash":
            errors.append("Pi default model drift")
    expected = {role["model_path"]: role for role in roles.values()}
    for settings in qwen_settings:
        auth_type = settings.get("security", {}).get("auth", {}).get("selectedType")
        if auth_type is not None and auth_type != "openai":
            errors.append("Qwen auth routing drift")
        advisor = settings.get("advisorModel")
        if advisor and advisor not in expected:
            errors.append("Qwen contains non-local advisor routing")
        default_model = settings.get("model", {})
        if isinstance(default_model, dict) and "baseUrl" in default_model:
            general = roles["GENERAL"]
            endpoint = f"http://{general['host']}:{general['port']}/v1"
            if default_model["baseUrl"] != endpoint:
                errors.append("Qwen default endpoint drift")
        if "modelProviders" in settings:
            provider_map = settings["modelProviders"]
            if set(provider_map) != {"openai"}:
                errors.append("Qwen contains cloud provider routing")
            models = provider_map.get("openai", [])
            if {model.get("id") for model in models} != set(expected) or len(models) != 3:
                errors.append("Qwen local role catalog drift")
            for model in models:
                role = expected.get(model.get("id"))
                if role is None:
                    continue
                endpoint = f"http://{role['host']}:{role['port']}/v1"
                if model.get("baseUrl") != endpoint:
                    errors.append("Qwen local endpoint drift")
                if model.get("generationConfig", {}).get("contextWindowSize") != role["context"]:
                    errors.append("Qwen local context drift")
        model = settings.get("model", {})
        if isinstance(model, dict):
            model = model.get("name")
        if model != roles["GENERAL"]["model_path"]:
            errors.append("Qwen default model drift")


def validate(
    manifest_path: Path, *, check_hashes: bool = False, check_host: bool = True
) -> list[str]:
    manifest = _load_json(manifest_path)
    roles = manifest["roles"]
    clients = manifest["clients"]
    errors: list[str] = []

    def expect(label: str, actual: Any, expected: Any) -> None:
        if actual != expected:
            errors.append(f"{label}: expected {expected!r}, got {actual!r}")

    expect("schema", manifest["schema_version"], 1)
    expect("runtime manager", manifest["runtime_manager"], "scripts/llm")
    expect("roles", set(roles), {"GENERAL", "CODE", "VISION"})
    expect(
        "Pi contract",
        clients["pi"],
        {
            "provider": "deepseek",
            "model": "deepseek-flash",
            "local_lifecycle": False,
        },
    )
    expect("Qwen local-only", clients["qwen"]["local_only"], True)
    expect("Qwen default role", clients["qwen"]["default_role"], "GENERAL")
    expect("Qwen fallback", clients["qwen"]["cloud_fallback"], False)
    launcher = _load_script(REPO / "scripts/llm", "_neuralengine_llm_manifest")
    for name, profile, port, ubatch, fa in (
        ("GENERAL", launcher.DEFAULT_PROFILE, 18081, 512, "auto"),
        ("CODE", launcher.DEFAULT_CODE_PROFILE, 18080, 1024, "on"),
        ("VISION", launcher.DEFAULT_VISION_PROFILE, 18082, 512, "auto"),
    ):
        role = roles[name]
        args = profile.arguments()
        expect(f"{name} enabled", role["enabled"], True)
        expect(f"{name} state", role["state"], "ACTIVE")
        expect(f"{name} model", str(profile.model), role["model_path"])
        expect(f"{name} model ID", role["expected_v1_models_id"], role["model_path"])
        expect(f"{name} runtime", str(profile.runtime), role["runtime_binary"])
        expect(f"{name} host", profile.host, role["host"])
        expect(f"{name} port", profile.port, port)
        expect(f"{name} manifest port", role["port"], port)
        expect(f"{name} backend", role["backend"], "Vulkan")
        expect(f"{name} runtime build", str(profile.runtime.parent.parent), role["runtime_build"])
        for field, flag, baseline in (
            ("context", "-c", 32768),
            ("batch", "-b", 2048),
            ("ubatch", "-ub", ubatch),
            ("ngl", "-ngl", 999),
            ("device", "-dev", "Vulkan0"),
            ("flash_attention", "-fa", fa),
            ("parallel", "--parallel", 1),
        ):
            expect(f"{name} manifest {field}", role[field], baseline)
            _expect_single_flag(
                errors, args, label=f"{name} {flag}", flag=flag, expected=str(baseline)
            )
        expect(f"{name} jinja", role["jinja"], True)
        _expect_single_toggle(
            errors, args, label=f"{name} --jinja", enabled="--jinja", disabled="--no-jinja"
        )
        expect(f"{name} MTP", role["mtp"], {"enabled": False})
        if any(arg.startswith("--spec-") for arg in args):
            errors.append(f"{name} contains speculative flags outside the baseline")
        expect(f"Qwen {name} context", clients["qwen"]["contexts"][name], 32768)
        _check_artifact(
            errors,
            f"{name} model",
            Path(role["model_path"]),
            role.get("model_sha256"),
            check_hashes,
        )
        _check_artifact(errors, f"{name} runtime", Path(role["runtime_binary"]), None, False)
        cache = Path(role["runtime_build"]) / "CMakeCache.txt"
        if not cache.is_file():
            errors.append(f"{name} runtime build cache missing")
        else:
            settings = cache.read_text()
            for setting in ("GGML_VULKAN:BOOL=ON", "GGML_HIP:BOOL=OFF", "GGML_BACKEND_DL:BOOL=OFF"):
                if setting not in settings:
                    errors.append(f"{name} build drift: {setting}")
        if name == "VISION":
            expect("VISION reasoning", role["reasoning"], "off")
            _expect_single_flag(
                errors, args, label="VISION reasoning", flag="--reasoning", expected="off"
            )
            _expect_single_flag(
                errors, args, label="VISION mmproj", flag="--mmproj", expected=role["mmproj_path"]
            )
            _check_artifact(
                errors,
                "VISION mmproj",
                Path(role["mmproj_path"]),
                role.get("mmproj_sha256"),
                check_hashes,
            )
        elif "--mmproj" in args:
            errors.append(f"{name} unexpectedly enables mmproj")
    if check_host:
        installed = Path.home() / ".local/bin/llm"
        expect("installed launcher", installed.resolve(), REPO / "scripts/llm")
        if not installed.is_symlink():
            errors.append("installed llm is not a symlink")
        _validate_client_settings(
            errors,
            roles,
            _load_json(Path.home() / ".pi/agent/models.json"),
            (
                _load_json(Path.home() / ".pi/agent/settings.json"),
                _load_json(REPO / ".pi/settings.json"),
            ),
            (
                _load_json(Path.home() / ".qwen/settings.json"),
                _load_json(REPO / ".qwen/settings.json"),
            ),
        )
    return errors


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", type=Path, default=REPO / "llm-manifest.json")
    parser.add_argument("--hash", action="store_true", help="rehash the GGUF files")
    args = parser.parse_args()
    try:
        errors = validate(args.manifest, check_hashes=args.hash)
    except (OSError, KeyError, IndexError, TypeError, ValueError, RuntimeError) as error:
        print(f"LLM manifest validation failed: {error}", file=sys.stderr)
        return 1
    for error in errors:
        print(f"DRIFT: {error}", file=sys.stderr)
    if errors:
        return 1
    print("LLM manifest: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
