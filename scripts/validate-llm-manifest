#!/usr/bin/env python3
"""Read-only drift check for the local production LLM manifest."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
from typing import Any

REPO = Path(__file__).resolve().parent.parent


def _load_json(path: Path) -> dict[str, Any]:
    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError(f"{path}: expected a JSON object")
    return value


def _load_script(path: Path, name: str) -> Any:
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"cannot load {path}")
    module = module_from_spec(spec)
    sys.modules[spec.name] = module
    loader.exec_module(module)
    return module


def _flag_value(args: tuple[str, ...], flag: str) -> str | None:
    return args[args.index(flag) + 1] if flag in args else None


def _expect_single_flag(
    errors: list[str],
    args: tuple[str, ...],
    *,
    label: str,
    flag: str,
    expected: str,
) -> None:
    """Require one unambiguous option/value pair in an active command."""

    values = [
        args[index + 1] if index + 1 < len(args) else None
        for index, value in enumerate(args)
        if value == flag
    ]
    if len(values) != 1:
        errors.append(f"{label}: expected exactly one {flag} value, got {values!r}")
    elif values[0] != expected:
        errors.append(f"{label}: expected {expected!r}, got {values[0]!r}")


def _expect_single_toggle(
    errors: list[str],
    args: tuple[str, ...],
    *,
    label: str,
    enabled: str,
    disabled: str,
) -> None:
    """Require one enabled toggle and reject its contradictory form."""

    count = args.count(enabled)
    if count != 1:
        errors.append(f"{label}: expected exactly one toggle, got {count}")
    if disabled in args:
        errors.append(f"{label}: contradictory {disabled} toggle is active")


def _check_artifact(
    errors: list[str], label: str, path: Path, digest: str | None, check_hashes: bool
) -> None:
    if not path.is_file():
        errors.append(f"{label} missing: {path}")
    elif check_hashes:
        if digest is None:
            errors.append(f"{label}: SHA256 not recorded")
        else:
            with path.open("rb") as handle:
                if hashlib.file_digest(handle, "sha256").hexdigest() != digest:
                    errors.append(f"{label}: SHA256 mismatch")


def _validate_client_settings(
    errors: list[str],
    roles: dict[str, Any],
    pi_catalog: dict[str, Any],
    pi_settings: tuple[dict[str, Any], ...],
    qwen_settings: tuple[dict[str, Any], ...],
    clients: dict[str, Any] | None = None,
) -> None:
    """Check routing only; never report credential-bearing configuration objects."""
    if clients is None:
        clients = _load_json(REPO / "llm-manifest.json")["clients"]
    pi_contract = clients["pi"]
    qwen_contract = clients["qwen"]
    expected_pi_provider = pi_contract.get("provider")
    expected_pi_model = pi_contract.get("model")
    providers = pi_catalog.get("providers", {})
    if not isinstance(providers, dict):
        errors.append("Pi provider catalog drift")
        providers = {}
    if expected_pi_provider is not None and set(providers) - {expected_pi_provider}:
        errors.append("Pi contains provider entries outside the manifest contract")
    for provider in providers.values():
        models = provider.get("models", []) if isinstance(provider, dict) else None
        if not isinstance(models, list) or any(
            not isinstance(model, dict) or model.get("id") != expected_pi_model for model in models
        ):
            errors.append("Pi contains model entries outside the manifest contract")
    for settings in pi_settings:
        if settings.get("defaultProvider") != expected_pi_provider:
            errors.append("Pi default provider drift")
        if settings.get("defaultModel") != expected_pi_model:
            errors.append("Pi default model drift")
    expected = {
        role["model_path"]: role
        for role in roles.values()
        if role.get("enabled") is True and role.get("state") == "ACTIVE"
    }
    for settings in qwen_settings:
        security = settings.get("security", {})
        auth = security.get("auth", {}) if isinstance(security, dict) else {}
        auth_type = auth.get("selectedType") if isinstance(auth, dict) else None
        advisor = settings.get("advisorModel")
        if advisor and (not isinstance(advisor, str) or advisor not in expected):
            errors.append("Qwen contains non-local advisor routing")
        if not qwen_contract.get("cloud_fallback", True) and settings.get("fallbackModel"):
            errors.append("Qwen cloud fallback drift")
        default_model = settings.get("model", {})
        if isinstance(default_model, dict) and "baseUrl" in default_model:
            default_role = qwen_contract["default_role"]
            default = roles.get(default_role, {})
            endpoint = f"http://{default.get('host')}:{default.get('port')}/v1"
            if default_model["baseUrl"] != endpoint:
                errors.append("Qwen default endpoint drift")
        provider_map = settings.get("modelProviders", {})
        if not isinstance(provider_map, dict):
            errors.append("Qwen provider catalog drift")
            provider_map = {}
        all_models = [
            model
            for models in provider_map.values()
            if isinstance(models, list)
            for model in models
            if isinstance(model, dict)
        ]
        if qwen_contract.get("local_only"):
            actual_ids = [model.get("id") for model in all_models]
            if set(actual_ids) != set(expected) or len(actual_ids) != len(expected):
                errors.append("Qwen contains cloud provider routing")
        selected_types = {
            provider_name
            for provider_name, models in provider_map.items()
            if isinstance(models, list)
            and models
            and all(model.get("id") in expected for model in models if isinstance(model, dict))
            and all(isinstance(model, dict) and model.get("id") in expected for model in models)
        }
        if (
            auth_type is not None
            and qwen_contract.get("local_only")
            and auth_type not in selected_types
        ):
            errors.append("Qwen auth routing drift")
        for model in all_models:
            role = expected.get(model.get("id"))
            if role is None:
                continue
            endpoint = f"http://{role['host']}:{role['port']}/v1"
            if model.get("baseUrl") != endpoint:
                errors.append("Qwen local endpoint drift")
            generation = model.get("generationConfig", {})
            if not isinstance(generation, dict) or generation.get("contextWindowSize") != role.get(
                "context"
            ):
                errors.append("Qwen local context drift")
        model = settings.get("model", {})
        if isinstance(model, dict):
            model = model.get("name")
        default_role = qwen_contract.get("default_role")
        if model != roles.get(default_role, {}).get("model_path"):
            errors.append("Qwen default model drift")


def _profile_for_role(launcher: Any, role: str, default_role: str) -> Any | None:
    """Resolve the runtime profile exposed by scripts/llm for one contract role."""

    named = getattr(launcher, f"DEFAULT_{role}_PROFILE", None)
    if named is not None:
        return named
    default = getattr(launcher, "DEFAULT_PROFILE", None)
    if role == default_role or (
        default is not None and type(default).__name__.removesuffix("Profile").upper() == role
    ):
        return default
    return None


def validate(
    manifest_path: Path,
    *,
    check_hashes: bool = False,
    check_host: bool = True,
    check_host_assets: bool = True,
    repo_root: Path = REPO,
) -> list[str]:
    manifest = _load_json(manifest_path)
    roles = manifest["roles"]
    clients = manifest["clients"]
    errors: list[str] = []

    def expect(label: str, actual: Any, expected: Any) -> None:
        if actual != expected:
            errors.append(f"{label}: expected {expected!r}, got {actual!r}")

    expect("schema", manifest["schema_version"], 1)
    expect("runtime manager", manifest["runtime_manager"], "scripts/llm")
    if not isinstance(roles, dict) or not roles:
        errors.append("roles: expected a non-empty object")
        roles = {}
    if not isinstance(clients, dict) or not {"pi", "qwen"}.issubset(clients):
        errors.append("clients: expected Pi and Qwen contracts")
        clients = {"pi": {}, "qwen": {}}
    default_role = clients.get("qwen", {}).get("default_role", "")
    launcher_path = repo_root / "scripts/llm"
    launcher = _load_script(launcher_path, "_neuralengine_llm_manifest")
    seen_profiles: set[str] = set()
    for name, role in roles.items():
        if not isinstance(role, dict):
            errors.append(f"{name} role: expected an object")
            continue
        profile = _profile_for_role(launcher, name, default_role)
        active = role.get("enabled") is True and role.get("state") == "ACTIVE"
        if not active:
            if profile is not None:
                errors.append(f"{name} profile: inactive role has an active launcher binding")
            continue
        if profile is None:
            errors.append(f"{name} profile: no active launcher binding")
            continue
        seen_profiles.add(name)
        role = roles[name]
        args = tuple(str(arg) for arg in profile.arguments())
        expect(f"{name} model", str(profile.model), role.get("model_path"))
        expect(f"{name} model ID", role.get("expected_v1_models_id"), role.get("model_path"))
        expect(f"{name} runtime", str(profile.runtime), role.get("runtime_binary"))
        expect(f"{name} host", profile.host, role.get("host"))
        expect(f"{name} port", profile.port, role.get("port"))
        if callable(getattr(profile, "endpoint", None)):
            expect(
                f"{name} endpoint",
                profile.endpoint(),
                f"http://{role.get('host')}:{role.get('port')}/v1",
            )
        expect(
            f"{name} runtime build",
            str(Path(profile.runtime).parent.parent),
            role.get("runtime_build"),
        )
        for field, flag in (
            ("context", "-c"),
            ("batch", "-b"),
            ("ubatch", "-ub"),
            ("ngl", "-ngl"),
            ("device", "-dev"),
            ("flash_attention", "-fa"),
            ("parallel", "--parallel"),
        ):
            if field not in role:
                errors.append(f"{name} manifest {field}: required profile field is missing")
                continue
            _expect_single_flag(
                errors, args, label=f"{name} {field}", flag=flag, expected=str(role[field])
            )
        if "jinja" not in role or not isinstance(role["jinja"], bool):
            errors.append(f"{name} manifest jinja: expected a boolean profile field")
        else:
            enabled = "--jinja" if role["jinja"] else "--no-jinja"
            disabled = "--no-jinja" if role["jinja"] else "--jinja"
            _expect_single_toggle(
                errors, args, label=f"{name} jinja", enabled=enabled, disabled=disabled
            )
        if "reasoning" in role:
            _expect_single_flag(
                errors,
                args,
                label=f"{name} reasoning",
                flag="--reasoning",
                expected=str(role["reasoning"]),
            )
        if "mmproj_path" in role:
            _expect_single_flag(
                errors, args, label=f"{name} mmproj", flag="--mmproj", expected=role["mmproj_path"]
            )
        elif "--mmproj" in args:
            errors.append(f"{name} unexpectedly enables mmproj")
        mtp = role.get("mtp", {})
        if not isinstance(mtp, dict) or not isinstance(mtp.get("enabled"), bool):
            errors.append(f"{name} MTP: expected an enabled boolean in the manifest")
        elif not mtp["enabled"] and any(arg.startswith("--spec-") for arg in args):
            errors.append(f"{name} enables MTP outside the manifest contract")
        elif mtp["enabled"]:
            _expect_single_flag(
                errors,
                args,
                label=f"{name} MTP path",
                flag="--spec-draft-model",
                expected=str(mtp.get("path", "")),
            )
        if check_host_assets:
            if not isinstance(role.get("model_path"), str):
                errors.append(f"{name} model path: required asset path is missing")
                continue
            _check_artifact(
                errors,
                f"{name} model",
                Path(role["model_path"]),
                role.get("model_sha256"),
                check_hashes,
            )
            _check_artifact(errors, f"{name} runtime", Path(role["runtime_binary"]), None, False)
            if "mmproj_path" in role:
                _check_artifact(
                    errors,
                    f"{name} mmproj",
                    Path(role["mmproj_path"]),
                    role.get("mmproj_sha256"),
                    check_hashes,
                )
            if mtp.get("enabled"):
                _check_artifact(
                    errors,
                    f"{name} MTP",
                    Path(mtp["path"]),
                    mtp.get("sha256"),
                    check_hashes,
                )
        if name in clients.get("qwen", {}).get("contexts", {}):
            expect(
                f"Qwen {name} context",
                clients["qwen"]["contexts"][name],
                role.get("context"),
            )
    for name, profile_constant in vars(launcher).items():
        if name == "DEFAULT_PROFILE":
            profile_role = default_role
        elif name.startswith("DEFAULT_") and name.endswith("_PROFILE"):
            profile_role = name.removeprefix("DEFAULT_").removesuffix("_PROFILE")
        else:
            continue
        if (
            callable(getattr(profile_constant, "arguments", None))
            and profile_role not in seen_profiles
        ):
            errors.append(f"{profile_role} launcher profile has no manifest role")
    if check_host:
        installed = Path.home() / ".local/bin/llm"
        expect("installed launcher", installed.resolve(), repo_root / "scripts/llm")
        if not installed.is_symlink():
            errors.append("installed llm is not a symlink")
        _validate_client_settings(
            errors,
            roles,
            _load_json(Path.home() / ".pi/agent/models.json"),
            (
                _load_json(Path.home() / ".pi/agent/settings.json"),
                _load_json(repo_root / ".pi/settings.json"),
            ),
            (
                _load_json(Path.home() / ".qwen/settings.json"),
                _load_json(repo_root / ".qwen/settings.json"),
            ),
            clients,
        )
    return errors


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", type=Path, default=REPO / "llm-manifest.json")
    parser.add_argument("--hash", action="store_true", help="rehash the GGUF files")
    args = parser.parse_args()
    try:
        errors = validate(args.manifest, check_hashes=args.hash)
    except (OSError, KeyError, IndexError, TypeError, ValueError, RuntimeError) as error:
        print(f"LLM manifest validation failed: {error}", file=sys.stderr)
        return 1
    for error in errors:
        print(f"DRIFT: {error}", file=sys.stderr)
    if errors:
        return 1
    print("LLM manifest: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
