#!/usr/bin/env python3
"""Read-only authority and drift validation for the local LLM stack."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
from typing import Any

REPO = Path(__file__).resolve().parent.parent
LOCAL_ROLES = ("LOCAL_GENERAL", "LOCAL_CODE", "LOCAL_VISION")
PROFILE_BINDINGS = {
    "current-general": "DEFAULT_PROFILE",
    "current-code": "DEFAULT_CODE_PROFILE",
    "current-qwen3-coder": "DEFAULT_QWEN3_CODER_PROFILE",
    "current-vision": "DEFAULT_VISION_PROFILE",
}


def _load_json(path: Path) -> dict[str, Any]:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise ValueError(f"{path}: expected a JSON object")
    return value


def _load_script(path: Path, name: str) -> Any:
    loader = SourceFileLoader(name, str(path))
    spec = spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"cannot load {path}")
    module = module_from_spec(spec)
    sys.modules[spec.name] = module
    loader.exec_module(module)
    return module


def _sha256(path: Path) -> str:
    with path.open("rb") as handle:
        return hashlib.file_digest(handle, "sha256").hexdigest()


def _expect_single_flag(
    errors: list[str], args: tuple[str, ...], *, label: str, flag: str, expected: str
) -> None:
    values = [
        args[index + 1] if index + 1 < len(args) else None
        for index, value in enumerate(args)
        if value == flag
    ]
    if len(values) != 1:
        errors.append(f"{label}: expected exactly one {flag} value, got {values!r}")
    elif values[0] != expected:
        errors.append(f"{label}: expected {expected!r}, got {values[0]!r}")


def _expect_single_toggle(
    errors: list[str], args: tuple[str, ...], *, label: str, enabled: str, disabled: str
) -> None:
    if args.count(enabled) != 1:
        errors.append(f"{label}: expected exactly one toggle, got {args.count(enabled)}")
    if disabled in args:
        errors.append(f"{label}: contradictory {disabled} toggle is active")


def _walk_keys(value: Any, path: str = "") -> list[tuple[str, str]]:
    found: list[tuple[str, str]] = []
    if isinstance(value, dict):
        for key, item in value.items():
            current = f"{path}.{key}" if path else str(key)
            found.append((str(key), current))
            found.extend(_walk_keys(item, current))
    elif isinstance(value, list):
        for index, item in enumerate(value):
            found.extend(_walk_keys(item, f"{path}[{index}]"))
    return found


def _check_asset(
    errors: list[str], label: str, path_value: Any, digest: Any, check_hashes: bool
) -> None:
    if not isinstance(path_value, str):
        errors.append(f"{label}: artifact path must be a string")
        return
    path = Path(path_value)
    if not path.is_file():
        errors.append(f"{label} missing: {path}")
    elif check_hashes:
        if not isinstance(digest, str):
            errors.append(f"{label}: SHA256 is missing")
        elif _sha256(path) != digest:
            errors.append(f"{label}: SHA256 mismatch")


def _validate_runtime_and_roles(
    errors: list[str],
    manifest: dict[str, Any],
    launcher: Any,
    *,
    check_host_assets: bool,
    check_hashes: bool,
) -> None:
    models = manifest.get("models")
    roles = manifest.get("roles")
    profiles = manifest.get("runtime_profiles")
    if not isinstance(models, dict) or not models:
        errors.append("models: expected a non-empty object")
        models = {}
    if not isinstance(roles, dict) or set(roles) != set(LOCAL_ROLES):
        errors.append("roles: expected exactly LOCAL_GENERAL, LOCAL_CODE, and LOCAL_VISION")
        roles = roles if isinstance(roles, dict) else {}
    if not isinstance(profiles, dict) or set(profiles) != set(PROFILE_BINDINGS):
        errors.append(
            "runtime_profiles: expected the four current deployment compatibility profiles"
        )
        profiles = profiles if isinstance(profiles, dict) else {}

    expected_context_keys = {"model_max_ctx", "runtime_ctx", "slot_ctx", "client_effective_ctx"}
    for role_name in LOCAL_ROLES:
        role = roles.get(role_name)
        if not isinstance(role, dict):
            continue
        if role.get("assignment") != "UNDECIDED":
            errors.append(f"{role_name}: final assignment must remain UNDECIDED")
        profile_name = role.get("current_deployment_profile")
        expected_projection = (
            "QUALIFIED_LOCAL_CODE_CANONICAL"
            if role_name == "LOCAL_CODE"
            else "CURRENT_DEPLOYMENT_COMPATIBILITY_ONLY"
        )
        if role.get("projection_status") != expected_projection:
            errors.append(f"{role_name}: projection status must be {expected_projection}")
        if profile_name not in profiles:
            errors.append(f"{role_name}: unknown current deployment profile {profile_name!r}")

    for profile_name, binding in PROFILE_BINDINGS.items():
        profile = profiles.get(profile_name)
        if not isinstance(profile, dict):
            continue
        model = models.get(profile.get("model_ref"))
        if not isinstance(model, dict):
            errors.append(f"{profile_name}: model_ref does not resolve")
            continue
        record = getattr(launcher, binding, None)
        if record is None:
            errors.append(f"{profile_name}: scripts/llm has no manifest-derived runtime binding")
            continue
        endpoint = profile.get("endpoint", {})
        runtime = profile.get("runtime", {})
        if str(record.model) != model.get("artifact_path"):
            errors.append(f"{profile_name}: launcher model does not match manifest inventory")
        if str(record.runtime) != runtime.get("binary"):
            errors.append(f"{profile_name}: launcher runtime does not match manifest")
        if getattr(record, "runtime_kind", None) != runtime.get("kind", "binary"):
            errors.append(f"{profile_name}: launcher runtime kind does not match manifest")
        for field in ("runtime_image", "runtime_image_digest", "container_name"):
            record_value = getattr(record, field, None)
            manifest_field = {
                "runtime_image": "image",
                "runtime_image_digest": "image_digest",
                "container_name": "container_name",
            }[field]
            manifest_value = runtime.get(manifest_field)
            if record_value != manifest_value:
                errors.append(f"{profile_name}: launcher {field} does not match manifest")
        if record.host != endpoint.get("host") or record.port != endpoint.get("port"):
            errors.append(f"{profile_name}: launcher endpoint does not match manifest")
        if callable(getattr(record, "endpoint", None)):
            expected_endpoint = (
                f"http://{endpoint.get('host')}:{endpoint.get('port')}{endpoint.get('path')}"
            )
            if record.endpoint() != expected_endpoint:
                errors.append(f"{profile_name}: endpoint projection drift")
        args = tuple(record.arguments())
        expected_args = tuple(
            argument.format_map(
                {
                    "model_path": str(record.model),
                    "projector_path": str(record.mmproj or ""),
                    "device": record.device,
                    "runtime_ctx": str(record.runtime_ctx),
                    "host": record.host,
                    "port": str(record.port),
                }
            )
            for argument in profile.get("arguments", [])
        )
        if args != expected_args:
            errors.append(f"{profile_name}: launcher arguments are not manifest-derived")

        layers = profile.get("context_layers")
        if not isinstance(layers, dict) or set(layers) != expected_context_keys:
            errors.append(f"{profile_name}: context layer schema is incomplete or ambiguous")
            continue
        model_ctx = layers.get("model_max_ctx")
        if not isinstance(model_ctx, dict) or model_ctx.get("model_ref") != profile.get(
            "model_ref"
        ):
            errors.append(f"{profile_name}: model_max_ctx must reference model inventory metadata")
            continue
        model_max = model.get("model_max_ctx", {}).get("tokens")
        runtime_ctx, slot_ctx, client_ctx = (
            layers.get("runtime_ctx"),
            layers.get("slot_ctx"),
            layers.get("client_effective_ctx"),
        )
        if any(
            type(value) is not int or value <= 0
            for value in (model_max, runtime_ctx, slot_ctx, client_ctx)
        ):
            errors.append(f"{profile_name}: context layers must be positive integer token counts")
        elif client_ctx > min(model_max, runtime_ctx, slot_ctx):
            errors.append(f"{profile_name}: client_effective_ctx exceeds a capacity layer")
        max_output_tokens = profile.get("max_output_tokens")
        if max_output_tokens is not None and (
            type(max_output_tokens) is not int or max_output_tokens <= 0
        ):
            errors.append(f"{profile_name}: max_output_tokens must be a positive integer or null")

        if check_host_assets:
            _check_asset(
                errors,
                f"{profile_name} model",
                model.get("artifact_path"),
                model.get("sha256"),
                check_hashes,
            )
            _check_asset(errors, f"{profile_name} runtime", runtime.get("binary"), None, False)
            projector_ref = profile.get("projector_ref")
            if projector_ref is not None:
                projector = models.get(projector_ref, {})
                _check_asset(
                    errors,
                    f"{profile_name} projector",
                    projector.get("artifact_path"),
                    projector.get("sha256"),
                    check_hashes,
                )


def _validate_qwen_projection(errors: list[str], path: Path, manifest: dict[str, Any]) -> None:
    settings = _load_json(path)
    routes = []
    for role_name in manifest["clients"]["qwen"]["local_roles"]:
        role = manifest["roles"][role_name]
        profile = manifest["runtime_profiles"][role["current_deployment_profile"]]
        model = manifest["models"][profile["model_ref"]]
        endpoint = profile["endpoint"]
        routes.append(
            {
                "id": model["model_id"],
                "name": role_name,
                "description": (
                    "Current deployment compatibility projection; "
                    "role assignment remains undecided."
                ),
                "envKey": "QWEN_LOCAL_API_KEY",
                "baseUrl": f"http://{endpoint['host']}:{endpoint['port']}{endpoint['path']}",
                "generationConfig": {
                    "contextWindowSize": profile["context_layers"]["client_effective_ctx"],
                    "maxTokens": profile["max_output_tokens"],
                    **({"modalities": {"image": True}} if model["kind"] == "vision" else {}),
                },
            }
        )
    providers = settings.get("modelProviders", {})
    if not isinstance(providers, dict) or providers.get("openai") != routes:
        errors.append(f"Qwen manifest route projection drift: {path}")
    default = manifest["roles"][manifest["clients"]["qwen"]["default_role"]]
    deployment = manifest["runtime_profiles"][default["current_deployment_profile"]]
    model = manifest["models"][deployment["model_ref"]]
    base = settings.get("model", {})
    if isinstance(base, dict):
        if base.get("name") != model["model_id"]:
            errors.append(f"Qwen default model projection drift: {path}")
        endpoint = deployment["endpoint"]
        if base.get("baseUrl") != f"http://{endpoint['host']}:{endpoint['port']}{endpoint['path']}":
            errors.append(f"Qwen default endpoint projection drift: {path}")
    elif base != model["model_id"]:
        errors.append(f"Qwen default model projection drift: {path}")
    if settings.get("fallbackModel") and not manifest["clients"]["qwen"].get("cloud_fallback"):
        errors.append(f"Qwen cloud fallback drift: {path}")


def _validate_host_configs(errors: list[str], manifest: dict[str, Any], repo_root: Path) -> None:
    home = Path.home()
    for path in (repo_root / ".qwen/settings.json", home / ".qwen/settings.json"):
        _validate_qwen_projection(errors, path, manifest)

    pi = manifest["clients"]["pi"]
    provider = pi["provider"]
    expected_local = {
        f"{provider}/{manifest['models'][manifest['runtime_profiles'][profile_name]['model_ref']]['model_id']}"
        for profile_name in pi["local_profiles"]
    }
    for path in (repo_root / ".pi/settings.json", home / ".pi/agent/settings.json"):
        settings = _load_json(path)
        if settings.get("defaultProvider") != pi["cloud_default_provider"]:
            errors.append(f"Pi cloud default provider drift: {path}")
        if settings.get("defaultModel") != pi["cloud_default_model"]:
            errors.append(f"Pi cloud default model drift: {path}")
        enabled = settings.get("enabledModels", [])
        if not isinstance(enabled, list) or not expected_local.issubset(set(enabled)):
            errors.append(f"Pi local route allowlist drift: {path}")
        elif {item for item in enabled if item.startswith(f"{provider}/")} != expected_local:
            errors.append(f"Pi local route contains retired provider IDs: {path}")
        if f"{pi['cloud_default_provider']}/{pi['cloud_default_model']}" not in enabled:
            errors.append(f"Pi cloud route is not enabled: {path}")

    models_path = home / ".pi/agent/models.json"
    if models_path.is_file():
        models_config = _load_json(models_path)
        if provider in models_config.get("providers", {}):
            errors.append(
                "Pi contains a duplicate local provider route outside the manifest extension"
            )

    opencode_path = home / ".config/opencode/opencode.json"
    if opencode_path.is_file():
        config = _load_json(opencode_path)
        providers = config.get("provider", {})
        if any(name.startswith("llama-") for name in providers):
            errors.append("OpenCode local provider routes remain active")
        values = [config.get("model")]
        values.extend(
            item.get("model")
            for item in config.get("agents", {}).values()
            if isinstance(item, dict)
        )
        if any(isinstance(value, str) and value.startswith("llama-") for value in values):
            errors.append("OpenCode local model selection remains active")

    fish = home / ".config/fish/config.fish"
    if fish.is_file():
        source = fish.read_text(encoding="utf-8")
        if any(
            token in source for token in ("llama-general/", "llama-code/", "llm start", "llm stop")
        ):
            errors.append("Fish config retains OpenCode local route or lifecycle integration")


def validate(
    manifest_path: Path,
    *,
    check_hashes: bool = False,
    check_host: bool = True,
    check_host_assets: bool = True,
    repo_root: Path = REPO,
) -> list[str]:
    manifest = _load_json(manifest_path)
    errors: list[str] = []
    if manifest.get("schema_version") != 2:
        errors.append("schema: expected version 2")
    authority = manifest.get("authority", {})
    for key in ("model_inventory", "runtime_profiles", "endpoints", "roles"):
        if authority.get(key) != "llm-manifest.json":
            errors.append(f"authority.{key}: must be llm-manifest.json")
    if (
        authority.get("lifecycle_owner") != "scripts/llm"
        or manifest.get("runtime_manager") != "scripts/llm"
    ):
        errors.append("lifecycle owner must be scripts/llm")
    harness = manifest.get("client_harness", {})
    if harness.get("primary_local_harness") != "Pi":
        errors.append("primary local harness must be Pi")
    if harness.get("qwen_code") != "OPTIONAL_COMPATIBILITY_QWEN_SPECIALIST":
        errors.append("Qwen Code must remain an optional compatibility specialist")
    if harness.get("opencode") != "PARKED":
        errors.append("OpenCode must remain parked")
    if "PATCH" in manifest.get("roles", {}):
        errors.append("PATCH must not exist as a local model role")
    if any(key.lower() in {"context", "ctx"} for key, _ in _walk_keys(manifest)):
        errors.append("manifest contains an ambiguous context or ctx field")

    clients = manifest.get("clients", {})
    for client_name in ("qwen", "pi"):
        client = clients.get(client_name, {})
        if client.get("local_roles") != list(LOCAL_ROLES):
            errors.append(f"clients.{client_name}.local_roles drift")
        if client.get("local_lifecycle") is not False:
            errors.append(f"clients.{client_name} must not own local lifecycle")
    if clients.get("qwen", {}).get("default_role") != "LOCAL_GENERAL":
        errors.append("Qwen default role drift")
    if (
        clients.get("pi", {}).get("cloud_default_provider") != "deepseek"
        or clients.get("pi", {}).get("cloud_default_model") != "deepseek-flash"
    ):
        errors.append("Pi cloud capability/default drift")
    if clients.get("pi", {}).get("local_profiles") != [
        "current-code",
        "current-general",
        "current-qwen3-coder",
        "current-vision",
    ]:
        errors.append("Pi local profile projection drift")
    if (
        clients.get("opencode", {}).get("status") != "PARKED"
        or clients.get("opencode", {}).get("local_roles") != []
    ):
        errors.append("OpenCode must remain parked without local routes")
    challenger = manifest.get("challengers", {}).get("qwen38", {})
    if (
        challenger.get("status") != "QUALIFIED"
        or challenger.get("eligible_for_role_assignment") is not True
        or challenger.get("qualified_roles") != ["LOCAL_CODE"]
    ):
        errors.append("Qwen3.8 qualification must be scoped to LOCAL_CODE")
    if manifest.get("roles", {}).get("LOCAL_CODE", {}).get("projection_status") != (
        "QUALIFIED_LOCAL_CODE_CANONICAL"
    ):
        errors.append("LOCAL_CODE must project the qualified Qwen3.8 route")
    if manifest.get("runtime_profiles", {}).get("current-code", {}).get("model_ref") != (
        "qwen38-halogen"
    ):
        errors.append("current-code must bind qwen38-halogen")
    qualification = challenger.get("qualification", {})
    if qualification.get("R2.3") != "NOT_RUN" or qualification.get("benchmarks_frozen") is not True:
        errors.append("benchmark freeze or R2.3 state drift")

    manager_path = repo_root / "scripts/llm"
    launcher = _load_script(manager_path, "_neuralengine_manifest_validation")
    _validate_runtime_and_roles(
        errors, manifest, launcher, check_host_assets=check_host_assets, check_hashes=check_hashes
    )
    if check_host:
        _validate_host_configs(errors, manifest, repo_root)
        installed = Path.home() / ".local/bin/llm"
        if not installed.is_file() or _sha256(installed) != _sha256(manager_path):
            errors.append("installed llm differs from scripts/llm")
        if not installed.stat().st_mode & 0o111:
            errors.append("installed llm is not executable")

    qwen_wrapper = (repo_root / "scripts/qwen-role.fish").read_text(encoding="utf-8")
    if "llm start" in qwen_wrapper or "llm stop" in qwen_wrapper or "127.0.0.1:" in qwen_wrapper:
        errors.append("Qwen wrapper owns lifecycle or duplicates an endpoint")
    pi_extension = (repo_root / "integrations/pi/extensions/local-model-projection.ts").read_text(
        encoding="utf-8"
    )
    if any(
        token in pi_extension
        for token in ("child_process", "llm start", "llm stop", "18080", "18081", "18082")
    ):
        errors.append("Pi extension owns lifecycle or duplicates an endpoint")
    opencode_wrapper = (repo_root / "scripts/opencode-watch").read_text(encoding="utf-8")
    if "llm start" in opencode_wrapper or "llm stop" in opencode_wrapper:
        errors.append("OpenCode wrapper retains LLM lifecycle behavior")
    return errors


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", type=Path, default=REPO / "llm-manifest.json")
    parser.add_argument("--hash", action="store_true", help="rehash current GGUF assets")
    parser.add_argument("--repo-only", action="store_true", help="skip host config checks")
    args = parser.parse_args()
    try:
        errors = validate(args.manifest, check_hashes=args.hash, check_host=not args.repo_only)
    except (OSError, KeyError, IndexError, TypeError, ValueError, RuntimeError) as error:
        print(f"LLM manifest validation failed: {error}", file=sys.stderr)
        return 1
    for error in errors:
        print(f"DRIFT: {error}", file=sys.stderr)
    if errors:
        return 1
    print("LLM manifest: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
