"""Isolated lifecycle for local challenger model endpoints."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from collections.abc import Iterator
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path

SERVER = Path("/home/grzanka/Work/LLM/strix-llama.cpp/build-vulkan/bin/llama-server")
REPO = Path(__file__).resolve().parent
HOST = "127.0.0.1"
PRODUCTION_PORTS = (18080, 18081, 18082)
RETIRED_CONFLICT_PORTS = (18087,)


def _canonical_patch_sha256() -> str:
    """Read the active PATCH digest from the repository manifest."""

    try:
        value = json.loads((REPO / "llm-manifest.json").read_text())["roles"]["PATCH"][
            "model_sha256"
        ]
    except (OSError, KeyError, TypeError, ValueError) as error:
        raise RuntimeError("cannot read canonical PATCH model SHA-256") from error
    if not isinstance(value, str) or len(value) != 64:
        raise RuntimeError("canonical PATCH model SHA-256 is invalid")
    return value


PATCH_MODEL_SHA256 = _canonical_patch_sha256()


@dataclass(frozen=True)
class Profile:
    name: str
    model: Path
    port: int
    options: tuple[str, ...]
    model_id: str | None = None
    expected_sha256: str | None = None
    owner_required: bool = False

    @property
    def endpoint_model_id(self) -> str:
        return self.model_id or str(self.model)

    @property
    def command(self) -> tuple[str, ...]:
        return self.command_for()

    def command_for(
        self,
        *,
        context: int | None = None,
        batch: int | None = None,
        ubatch: int | None = None,
    ) -> tuple[str, ...]:
        settings = (context, batch, ubatch)
        if self.name != "gptoss":
            if any(value is not None for value in settings):
                raise RuntimeError(f"{self.name} does not support runtime tuning options")
            options = self.options
        else:
            context = 32768 if context is None else context
            batch = 2048 if batch is None else batch
            ubatch = 1024 if ubatch is None else ubatch
            if context not in (32768, 65536):
                raise RuntimeError("GPT-OSS context must be 32768 or 65536")
            if batch not in (1024, 2048, 4096):
                raise RuntimeError("GPT-OSS batch must be 1024, 2048, or 4096")
            if ubatch not in (256, 512, 1024, 2048) or ubatch > batch:
                raise RuntimeError("GPT-OSS ubatch must be 256/512/1024/2048 and <= batch")
            values = {"-c": str(context), "-b": str(batch), "-ub": str(ubatch)}
            tuned: list[str] = []
            index = 0
            while index < len(self.options):
                option = self.options[index]
                tuned.append(option)
                if option in values:
                    tuned.append(values[option])
                    index += 2
                else:
                    index += 1
            options = tuple(tuned)
        return (
            str(SERVER),
            "-m",
            str(self.model),
            *options,
            *(("--alias", self.model_id) if self.model_id else ()),
            "--host",
            HOST,
            "--port",
            str(self.port),
        )


